-    prepared: List[Dict[str, Any]] = []
-    for i, ev in enumerate(events):
-        e = dict(ev)
-        e.update(
-            {
-                "v": 1,
-                "seq": 1 + i,
-                "append": 1,
-                "at": now_utc,
-                "actor": actor or {"tool": "artifact_meta"},
-            }
-        )
-        if by_human:
