+    v_box = "x" if valid_pass else " "
+    v_res = "pass" if valid_pass else "pending"
+    v_ev = "pytest passed (1 passed)" if valid_pass else ""
+    return (
+        f"# IPD: {title}\n\n"
+        "## Concern\n\n"
+        "Implement the declared feature cleanly.\n\n"
+        "## Scope\n\n"
