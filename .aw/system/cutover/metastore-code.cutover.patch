+    assert vo_after[0] == "go-pending-approval"
+    assert vo_after[1] == "reviewed"
+    assert "APPROVE WITH REVISIONS APPLIED" in vo_after[2]
+    assert (
+        review_sequence.count_verdict_bearing_entries(
+            plan_text_after, history=hist_after
+        )
+        == 1
+    )
+
+    err_s7 = review_sequence.check_S7(
+        plan_text_before,
+        plan_text_after,
+        yaml_review_unescalated,
+        "",
+        state_before=st_before,
+        state_after=st_after,
+        history_before=hist_before,
+        history_after=hist_after,
+    )
+    assert err_s7 is None
+
+    # 5. rereview_triggers & run_rereview_loop detect log-only Scope-Paths edit via read_state
+    trig = review_rereview.rereview_triggers(
+        plan_text_before,
