+def test_status_set_orchestrator_readiness_ordering_retirement_commit_and_prompt_guard(
+    tmp_path: Path,
+) -> None:
+    """status_set enforces log-format orchestrator readiness + child-first ordering, commits orch log on child retirement, skips dirty orch log, and refuses hot status on log research-prompt."""
+    repo = _init_log_repo(tmp_path, name="status-set-repo")
+    ctx = meta.legacy_context(repo)
+
+    # Seed a log-format Set with 1 orchestrator and 2 children.
