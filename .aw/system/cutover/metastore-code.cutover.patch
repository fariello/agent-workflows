+    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+        assert backlog.run_note(note_args) == 0
+    agents_ctx = backlog._records_context(agents_rec, repo)
+    hist = meta.history("mix002", project_context=agents_ctx)
+    assert any(
