+    )
+    lines: list[str] = [
+        f"# Review findings: {subject_type} {subject_id}",
+        "",
+    ]
+    for rnd in rounds:
+        lines.append(f"## Round {rnd.number}")
+        lines.append("")
+        lines.append(f"### {_review_findings.H_FINDINGS}")
+        lines.append("")
+        lines.extend(
+            _review_findings._table(
+                _review_findings.FINDING_COLUMNS,
+                [
+                    (
+                        f.id,
+                        f.severity,
+                        f.scope,
+                        f.area,
+                        f.evidence,
+                        f.finding,
+                        f.remediation_risk,
+                        f.decision,
+                        f.resolution,
+                    )
+                    for f in rnd.findings
+                ],
+            )
+        )
+        lines.append("")
+        if rnd.decisions:
+            lines.append(f"### {_review_findings.H_DECISIONS}")
+            lines.append("")
+            lines.extend(
+                _review_findings._table(
+                    _review_findings.DECISION_COLUMNS,
+                    [
+                        (
+                            d.id,
+                            d.question,
+                            d.chosen,
+                            d.alternatives,
+                            d.basis,
+                            d.reversible,
+                        )
+                        for d in rnd.decisions
+                    ],
+                )
+            )
+            lines.append("")
+    return mirror + "\n".join(lines).rstrip("\n") + "\n"
