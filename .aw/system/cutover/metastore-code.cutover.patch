+    assert any("Scope-Paths" in r for r in trig)
+
+    current_state_box = [st_mut]  # log Scope-Paths changed during pass 1 while .ipd.md is unchanged
+    prompts_sent: list[str] = []
+
+    def _send(prompt: str, grp: Any = None, pno: Any = None) -> str:
+        prompts_sent.append(prompt)
+        return "Checked changes.\nAW-REVIEW: DONE"
+
+    r_ctx = review_sequence.ReviewSequenceContext(
+        send_prompt=_send,
+        tier="standard",
+        variant="single-12",
+        checks_run={"P", "T", "R1", "R2", "R3", "R4", "S5", "S6"},
+        plan_path=p_path,
+        review_path=repo / ".aw" / "records" / "reviews",
+        pass_start_text=plan_text_before,
+        pass_no=1,
+        baseline={},
+        review_steps=[],
