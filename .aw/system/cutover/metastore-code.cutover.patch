+def test_same_status_field_only_updates_append_and_report_changed_idempotently(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """E-02 (kj0neb): same-status field-only `aw ipd set` appends log and reports changed=True; no-ops stay unchanged."""
+    aw_home = tmp_path / "aw_home"
+    aw_home.mkdir()
+    monkeypatch.setenv("AW_HOME", str(aw_home))
+
+    repo = _bare_records_repo(tmp_path / "field_only_repo")
+    rb = RecordBuilder(repo)
+    rb.spec(id6="sp3001", set="sp3001", status="approved", title="Target Spec")
+    plan_path = Path(
+        rb.plan(
+            id6="pl3001",
+            set="fset",
+            order=1,
+            status="to-review",
+            title="Plan for field-only updates",
+        )
+    )
+    _git_commit_all(repo, "seed spec and plan")
+
+    log_path = repo / ".aw" / "records" / "meta" / "pl3001.jsonl"
+    ctx = meta.legacy_context(repo)
+    md_before = plan_path.read_bytes()
+    log_lines_0 = log_path.read_text(encoding="utf-8").splitlines()
+
+    # 1. Set `--from-spec sp3001` at the same status (`to-review`): must append and report changed=True.
+    rc, out, err = _run_cli_in_repo(
+        repo,
+        [
+            "ipd",
+            "set",
+            "to-review",
+            "pl3001",
+            "--from-spec",
+            "sp3001",
+            "--yes",
+            "--no-commit",
+            "--json",
+        ],
+        monkeypatch,
+    )
+    assert rc == 0, f"stdout={out}\nstderr={err}"
+    payload = json.loads(out)
+    assert payload["changes"][0]["kind"] == "update"
+    assert payload["changes"][0]["applied"] is True
+    assert payload["data"]["items"][0]["changed"] is True
+
+    log_lines_1 = log_path.read_text(encoding="utf-8").splitlines()
+    assert len(log_lines_1) > len(log_lines_0)
+    assert plan_path.read_bytes() == md_before
+    st_after_set = meta.read("pl3001", project_context=ctx)
+    assert (st_after_set.fields or {}).get("from_spec") == "sp3001"
+
+    # Unchanged .md file must not appear modified in git status; only meta log changed.
+    porcelain_after_set = _status_paths(repo)
+    assert ".aw/records/meta/pl3001.jsonl" in porcelain_after_set
+    assert plan_path.name not in porcelain_after_set
+
+    # 2. Repeat identical `--from-spec sp3001`: must be an idempotent no-op.
+    rc, out, err = _run_cli_in_repo(
+        repo,
+        [
+            "ipd",
+            "set",
+            "to-review",
+            "pl3001",
+            "--from-spec",
+            "sp3001",
+            "--yes",
+            "--no-commit",
+            "--json",
+        ],
+        monkeypatch,
+    )
+    assert rc == 0, f"stdout={out}\nstderr={err}"
+    payload_noop_set = json.loads(out)
+    assert payload_noop_set["changes"][0]["kind"] == "noop"
+    assert payload_noop_set["changes"][0]["applied"] is False
+    assert "(unchanged)" in payload_noop_set["changes"][0]["detail"]
+    assert payload_noop_set["data"]["items"][0]["changed"] is False
+    assert log_path.read_text(encoding="utf-8").splitlines() == log_lines_1
+
+    # 3. Clear `--from-spec -` at the same status (`to-review`): must append and report changed=True.
+    rc, out, err = _run_cli_in_repo(
+        repo,
+        [
+            "ipd",
+            "set",
+            "to-review",
+            "pl3001",
+            "--from-spec",
+            "-",
+            "--yes",
+            "--no-commit",
+            "--json",
+        ],
+        monkeypatch,
+    )
+    assert rc == 0, f"stdout={out}\nstderr={err}"
+    payload_clear = json.loads(out)
+    assert payload_clear["changes"][0]["kind"] == "update"
+    assert payload_clear["changes"][0]["applied"] is True
+    assert payload_clear["data"]["items"][0]["changed"] is True
+
+    log_lines_2 = log_path.read_text(encoding="utf-8").splitlines()
+    assert len(log_lines_2) > len(log_lines_1)
+    assert plan_path.read_bytes() == md_before
+    st_after_clear = meta.read("pl3001", project_context=ctx)
+    assert (st_after_clear.fields or {}).get("from_spec") is None
+
+    # 4. Repeat identical `--from-spec -`: clearing an already-absent field must be a no-op.
+    rc, out, err = _run_cli_in_repo(
+        repo,
+        [
+            "ipd",
+            "set",
+            "to-review",
+            "pl3001",
+            "--from-spec",
+            "-",
+            "--yes",
+            "--no-commit",
+            "--json",
+        ],
+        monkeypatch,
+    )
+    assert rc == 0, f"stdout={out}\nstderr={err}"
+    payload_noop_clear = json.loads(out)
+    assert payload_noop_clear["changes"][0]["kind"] == "noop"
+    assert payload_noop_clear["changes"][0]["applied"] is False
+    assert "(unchanged)" in payload_noop_clear["changes"][0]["detail"]
+    assert payload_noop_clear["data"]["items"][0]["changed"] is False
+    assert log_path.read_text(encoding="utf-8").splitlines() == log_lines_2
+
