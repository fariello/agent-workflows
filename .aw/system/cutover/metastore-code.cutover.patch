+    # _read_status on BOM-prefixed YAML mirror, managed prompt mirror, and legacy multi-word status
+    assert selectors._read_status(p_plan.read_text(encoding="utf-8")) == "approved"
+    assert selectors._read_status(p_prompt.read_text(encoding="utf-8")) == "pending"
+    legacy_multi = (
