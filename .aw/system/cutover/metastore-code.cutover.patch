+# --------------------------------------------------------------------------------------
+# Event-owned fields (spec 4sd62s AC-15), review_kind / refinement (AC-14a), and leak refusal
+# (Migrated from retired tests/test_artifact_meta_legacy_write.py under IPD nv3upa E-03)
+# --------------------------------------------------------------------------------------
+
+
+def _make_log_ctx(tmp_path: Path):
+    records_root = tmp_path / "records"
+    state_root = tmp_path / "state"
+    records_root.mkdir()
+    state_root.mkdir()
+    ctx = type(
+        "Ctx", (), {"logical_roots": {"records": records_root, "state": state_root}}
+    )()
+    return records_root, ctx
+
+
+def _refuse_append(
+    records_root: Path,
+    ctx: object,
+    id6: str,
+    events: list[dict],
+    match: str,
+) -> str:
+    log_p = records_root / "meta" / f"{id6}.jsonl"
+    before = log_p.read_bytes()
+    with pytest.raises(ValueError, match=match) as exc:
+        meta.append(id6, events, project_context=ctx)
+    assert log_p.read_bytes() == before
+    return str(exc.value)
+
+
+def test_append_ac15_1_set_readiness_refused_alone_and_beside_review(
+    tmp_path: Path,
+) -> None:
+    """AC-15 (1): generic set of review-owned readiness is refused alone and beside a review."""
+    records_root, ctx = _make_log_ctx(tmp_path)
+    meta.create(
+        "ac1501",
+        "ipd",
+        {"status": "draft", "set": "pset", "order": 1},
+        "# IPD: P\n\n## Goal\nG\n",
+        destination="plans/pending/20260101-pset-01-ac1501-p.ipd.md",
+        project_context=ctx,
+    )
+    _refuse_append(
+        records_root,
+        ctx,
+        "ac1501",
+        [{"op": "set", "fields": {"readiness": "go"}}],
+        "review-owned field 'readiness'",
+    )
+    _refuse_append(
+        records_root,
+        ctx,
+        "ac1501",
+        [
+            {"op": "review", "round": 1, "review_kind": "gate", "verdict": "APPROVE"},
+            {"op": "set", "fields": {"readiness": "go"}},
+        ],
+        "review-owned",
+    )
