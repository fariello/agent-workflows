+def _resolve_plan_records_roots(
+    plan_path: Path, *, repo_root: Optional[Path] = None
+) -> Tuple[List[Path], Optional[Path]]:
+    """Return ordered candidate records roots and inferred owner repo root for ``plan_path``."""
+    from agent_workflows import project_context as _pc
+
+    candidates: List[Path] = []
+    seen: Set[Path] = set()
+
+    def _add(p: Optional[Path]) -> None:
+        if p is None:
+            return
+        try:
+            res = p.resolve()
+        except OSError:
+            res = p
+        if res not in seen:
+            seen.add(res)
+            candidates.append(res)
+
+    try:
+        resolved = plan_path.resolve()
+    except OSError:
+        resolved = plan_path
+
+    for parent in resolved.parents:
+        if parent.name == "plans":
+            _add(parent.parent)
+            break
+
+    owner: Optional[Path] = repo_root.resolve() if repo_root is not None else None
+    if owner is None and candidates:
+        rr = candidates[0]
+        if rr.name == "records" and rr.parent.name == ".aw":
+            owner = rr.parent.parent
+        elif rr.name == ".agents":
+            owner = rr.parent
+        else:
+            for anc in [rr] + list(rr.parents):
+                if (
+                    (anc / ".aw").is_dir()
+                    or (anc / ".agents").is_dir()
+                    or (anc / ".git").exists()
+                ):
+                    owner = anc
+                    break
+            if owner is None:
+                owner = rr
+
+    if owner is not None:
+        try:
+            _add(_pc.project_records_dir(owner))
+        except Exception:
+            pass
+        _add(owner / ".aw" / "records")
+        legacy_agents = owner / ".agents"
+        if legacy_agents.is_dir():
+            _add(legacy_agents)
+
+    return candidates, owner
+
+
+def _records_context(records_root: Path, owner: Optional[Path]) -> Any:
+    """Build a lightweight project context pointing ``records`` at ``records_root``."""
+    from agent_workflows import artifact_meta as _meta
+
+    rr = records_root.resolve()
+    repo = owner.resolve() if owner is not None else rr
+    base_ctx = _meta.legacy_context(repo)
+    return type(
+        "LegacyContext",
+        (),
+        {
+            "logical_roots": {
+                "records": str(rr),
+                "state": base_ctx.logical_roots["state"],
+            },
+            "repo_root": repo,
