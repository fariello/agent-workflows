+    assert len(d_drift) == 1
+    assert d_drift[0].rule == "check.review-decision-unescalated"
+    assert "D-01" in d_drift[0].detail
+
+    # Escalating via a blocking OQ carrying - Finding: PR-001 clears both
+    escalated_plan_path = _create_log_plan(
