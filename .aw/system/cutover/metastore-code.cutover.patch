+def _search_json(
+    repo: Path, pattern: str, *, full: bool = False, types: list[str] | None = None
+) -> tuple[int, dict]:
+    buf = io.StringIO()
+    ns = argparse.Namespace(
+        type=pattern,
+        selector=[],
+        types=types or [],
+        status=[],
+        status_not=[],
+        full=full,
+        line_numbers=False,
+        short=False,
+        files_only=False,
+        paths=False,
+        limit=None,
+        dir=str(repo),
+        json=True,
+        agent=False,
+    )
+    with redirect_stdout(buf):
+        rc = cli._run_search(ns, Term(color=False))
+    return rc, json.loads(buf.getvalue())
