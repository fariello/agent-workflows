+        "pl1007",
+        slug="uncommitted-recheck",
+        extra_events=[
+            {
+                "seq": 1,
+                "append": 1,
+                "op": "review",
+                "at": "2026-11-26T11:00:00Z",
+                "actor": {"tool": "aw plan-review"},
+                "review_kind": "gate",
+                "round": 1,
+                "verdict": "REVIEWED - OPEN QUESTIONS",
+                "readiness": "no-go",
+                "message": "PR-001 FIXED",
