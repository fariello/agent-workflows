+def _git(repo: Path, *args: str) -> str:
+    proc = subprocess.run(
+        ["git", *args],
+        cwd=str(repo),
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return proc.stdout.strip()
+
+
+def _init_log_repo(tmp_path: Path, *, name: str = "repo", with_git: bool = True) -> Path:
+    repo = tmp_path / name
+    for sub in (
+        ".aw/config",
+        ".aw/state",
+        ".aw/inbox",
+        ".aw/records/meta",
+        ".aw/records/plans/pending",
+        ".aw/records/plans/executed",
+        ".aw/records/plans/superseded",
+        ".aw/records/plans/not-executed",
+        ".aw/records/specs/to-review",
+        ".aw/records/specs/reviewed",
+        ".aw/records/specs/approved",
+        ".aw/records/backlog/open",
+        ".aw/records/backlog/graduated",
+        ".aw/records/backlog/blocked",
+        ".aw/records/research",
+        ".aw/records/reviews",
+    ):
+        (repo / sub).mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "config" / "project.json").write_text(
+        json.dumps(
+            {
+                "metadata_schema": 2,
+                "records_backend": "repository",
+                "placements": {"records": "target-tracked"},
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    if with_git:
+        _git(repo, "init", "-q", "-b", "main")
+        _git(repo, "config", "user.name", "Test User")
+        _git(repo, "config", "user.email", "test@example.com")
+        _git(repo, "add", "-A")
+        _git(repo, "commit", "-q", "-m", "init")
+    return repo
+
+
+def _git_commit_all(repo: Path, msg: str = "seed") -> None:
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-q", "-m", msg)
+
+
+def _git_last_commit_files(repo: Path) -> List[str]:
+    out = _git(repo, "log", "-1", "--name-only", "--pretty=format:")
+    return [line.strip() for line in out.splitlines() if line.strip()]
+
+
+def _run_cli(repo: Path, argv: List[str]) -> Tuple[int, str, str]:
+    out, err = io.StringIO(), io.StringIO()
+    full_argv = [*argv, "--dir", str(repo)]
+    with redirect_stdout(out), redirect_stderr(err):
+        try:
+            rc = cli.main(full_argv)
+        except SystemExit as exc:
+            rc = int(exc.code or 0)
+    return rc, out.getvalue(), err.getvalue()
+
+
+def _write_log(repo: Path, id6: str, events: List[Dict[str, Any]]) -> Path:
+    log_path = repo / ".aw" / "records" / "meta" / f"{id6}.jsonl"
+    norm = []
+    for ev in events:
+        row = {"v": 1, **ev}
+        if row.get("by_human") is False:
+            row.pop("by_human", None)
+        norm.append(row)
+    log_path.write_text(
+        "\n".join(json.dumps(ev, separators=(",", ":")) for ev in norm) + "\n",
+        encoding="utf-8",
+    )
+    return log_path
+
