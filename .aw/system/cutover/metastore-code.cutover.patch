+def _artifact_state_map(repo_root: Path) -> Dict[Path, Any]:
+    """Query all valid artifact states (with fields) under ``repo_root`` keyed by resolved Path."""
+    from agent_workflows import artifact_meta as _meta
+
+    root = Path(repo_root).resolve()
+    ctx = _meta.legacy_context(root)
+    records_root = Path(ctx.logical_roots["records"])
+    scan_repo = _meta._scan_repo_root(ctx, records_root)
+    state_map: Dict[Path, Any] = {}
+    try:
+        rows = _meta.query(project_context=ctx, include_fields=True).rows
+    except ValueError:
+        rows = []
+    for row in rows:
+        if not row.path:
+            continue
+        try:
+            abs_p = _meta.source_path(row.path, records_root, scan_repo).resolve()
+        except (ValueError, OSError):
+            continue
+        state_map[abs_p] = row
+    return state_map
+
+
+def _companion_records_root_for_path(path: Path, repo_root: Path) -> Path:
+    """Derive the records root (``.aw/records`` or ``.agents``) owning ``path``."""
+    try:
+        resolved = path.resolve()
+    except OSError:
+        resolved = path
+    for parent in resolved.parents:
+        if parent.name == "records" and parent.parent.name == ".aw":
+            return parent
+        if parent.name == ".agents":
+            return parent
+    return project_records_dir(Path(repo_root).resolve())
+
+
+def _read_artifact_state_for_path(
+    path: Path,
+    text: str,
+    repo_root: Path,
+    state_map: Dict[Path, Any],
+) -> Tuple[Any, bool]:
+    """Return ``(state, is_log_backed)`` for an arbitrary record file (backlog/spec/plan)."""
+    from agent_workflows import artifact_meta as _meta
+
+    try:
+        key = path.resolve()
+    except OSError:
+        key = path
+    cached = state_map.get(key)
+    if cached is not None:
+        is_log = bool(
+            getattr(cached, "created_at", None)
+            or getattr(cached, "updated_at", None)
+            or getattr(cached, "last_seq", 0) > 0
+        )
+        if is_log:
+            return cached, True
+
+    id6 = _meta.read_mirror_id6(text)
+    if id6 and _core.is_valid_id6(id6):
+        rr = _companion_records_root_for_path(path, repo_root)
+        log_path = rr / "meta" / f"{id6}.jsonl"
+        if log_path.is_file():
+            ctx = _records_context(rr, Path(repo_root).resolve())
+            try:
+                st = _meta.read(id6, project_context=ctx)
+                return st, True
+            except ValueError:
+                return None, False
+    return None, False
+
