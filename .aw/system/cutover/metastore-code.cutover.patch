-def _render_approval(text: str, value: str) -> str:
-    """`- Approval:` directly after `- Id:`, else after `- Status:`, else before the first `## `."""
-    lines = text.split("\n")
-    if any(re.match(r"^- Approval:\s*", ln) for ln in lines):
