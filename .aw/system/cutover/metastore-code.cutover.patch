+def _create_log_orchestrator_plan(
+    repo: Path,
+    id6: str,
+    *,
+    setid: str = "alpha",
+    status: str = "approved",
+    child_rows: list[tuple[int, str, str]],
+) -> Path:
+    ctx = meta.legacy_context(repo)
+    rel_dest = f"plans/pending/20261126-{setid}-00-{id6}-orchestrator.ipd.md"
+    table_lines = [
+        "| Order | Id | Plan | Summary | Item-Dependencies |",
+        "|---|---|---|---|---|",
+    ]
+    e_lines: list[str] = []
+    v_lines: list[str] = []
+    for idx, (ord_n, cid, cname) in enumerate(child_rows, start=1):
+        table_lines.append(
+            f"| {ord_n:02d} | `{cid}` | `{cname}` | Child {cid}. | none |"
+        )
+        e_lines.append(
+            f"- [ ] E-{idx:02d} CONFIRM {cid} REACHED executed\n"
+            "  - Depends on: none\n"
+            f"  - Expected outcome: `{cid}` is under `executed/`.\n"
+            "  - Execution state: pending\n"
+        )
+        v_lines.append(
+            f"- [ ] V-{idx:02d} validates E-{idx:02d}\n"
+            f"  - Required evidence: paste `aw find plans {cid}` showing `executed/`.\n"
+            "  - Observed evidence:\n"
+            "  - Result: pending\n"
+        )
+    body = (
+        f"# IPD: Orchestrator {setid}\n\n"
+        "## Concern\n\n"
+        f"Coordinate Set `{setid}`.\n\n"
+        "## Scope\n\n"
+        "Orchestrator bookkeeping only.\n\n"
+        "## Goal\n\n"
+        f"Retire once every child of Set `{setid}` is executed.\n\n"
+        "## Detailed Implementation Checklist (TODO)\n\n"
+        + "\n".join(e_lines)
+        + "\n## Child IPDs, sequence, and dependencies\n\n"
+        + "\n".join(table_lines)
+        + "\n\n## Completion criteria (the whole Set is done only when)\n\n"
+        "- Every child IPD reaches executed.\n\n"
+        "## Cross-IPD validation\n\n"
+        "- Child execution verified across the Set.\n\n"
+        "## Deferred / out of scope (with reason)\n\n"
+        "- None.\n\n"
+        "## Scope check\n\n"
+        "- Over-scope: none.\n"
+        "- Under-scope: none.\n\n"
+        "## Required tests / validation\n\n"
+        "- Child execution verified.\n\n"
+        "## Open questions\n\n"
+        "None open.\n\n"
+        "## Validation and cross-check (verify before reporting the Set complete)\n\n"
+        + "\n".join(v_lines)
+        + "\n## Approval and execution gate\n\n"
+        "- Size assessment: standard\n"
+        "- Cohesion rationale: not required\n\n"
+        "Retire automatically when all children are executed.\n"
+    )
+    meta.create(
+        id6,
+        "ipd",
+        {
+            "status": "to-review",
+            "title": f"Orchestrator {setid}",
+            "author": "antigravity/gemini",
+            "plan_role": "orchestrator",
+            "set": setid,
+            "order": 0,
+            "scope_paths": ["grandfathered"],
+            "highest_e_allocated": max(1, len(child_rows)),
+            "review_depth": "standard",
+            "work_kind": "chore",
+            "priority": "medium",
+        },
+        body,
+        destination=rel_dest,
+        project_context=ctx,
+    )
+    if status in ("reviewed", "approved"):
+        meta.append(
+            id6,
+            [
+                {
+                    "op": "review",
+                    "review_kind": "gate",
+                    "round": 1,
+                    "verdict": "APPROVE",
+                    "readiness": "go-pending-approval",
+                    "reviewer": "antigravity/gemini",
+                    "message": "reviewed",
+                },
+                {
+                    "op": "transition",
+                    "from": "to-review",
+                    "to": "reviewed",
+                    "message": "reviewed",
+                },
+            ],
+            project_context=ctx,
+            actor=_TEST_ACTOR,
+        )
+        if status == "approved":
+            meta.append(
+                id6,
+                [
