+    assert cov_res.written is True
+    _git_commit_all(repo, "seed setx")
+
+    # 1. Promoting orchestrator alone to to-review while child ch2001 is still draft is REFUSED
+    rc_refuse, out_refuse, err_refuse = _run_cli(
