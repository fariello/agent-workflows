+def _write_log(repo: Path, id6: str, events: list[dict[str, Any]]) -> Path:
+    log_path = repo / ".aw" / "records" / "meta" / f"{id6}.jsonl"
+    norm = []
+    for ev in events:
+        row = {"v": 1, **ev}
+        if row.get("by_human") is False:
+            row.pop("by_human", None)
+        norm.append(row)
+    log_path.write_text(
+        "\n".join(json.dumps(ev, separators=(",", ":")) for ev in norm) + "\n",
+        encoding="utf-8",
+    )
+    return log_path
+
