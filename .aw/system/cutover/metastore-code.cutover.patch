+def _populate_lane_branch(
+    repo: Path,
+    branch_name: str,
+    mutate_fn,
+) -> str:
+    base_sha = subprocess.run(
+        ["git", "rev-parse", "HEAD"],
+        cwd=repo,
+        capture_output=True,
+        text=True,
+        check=True,
+    ).stdout.strip()
+    wt = repo.parent / f"wt-{branch_name.replace('/', '-')}"
+    subprocess.run(
+        ["git", "worktree", "add", "-b", branch_name, str(wt), base_sha],
+        cwd=repo,
+        check=True,
+        capture_output=True,
+    )
+    try:
+        mutate_fn(wt)
+        subprocess.run(["git", "add", "."], cwd=wt, check=True)
+        subprocess.run(
+            ["git", "commit", "-qm", "lane defect backlogs"], cwd=wt, check=True
+        )
+    finally:
+        subprocess.run(
+            ["git", "worktree", "remove", "--force", str(wt)],
+            cwd=repo,
+            check=True,
+            capture_output=True,
+        )
+    return base_sha
+
