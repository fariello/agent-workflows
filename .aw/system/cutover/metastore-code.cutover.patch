+    res_yml = _lint.lint_text(mirror_only, checkpoint="author", directory="pending")
+    missing_fields = {
+        d.message.split(":", 1)[0]
+        for d in res_yml.diagnostics
+        if d.code == _lint.C_META_MISSING
+    }
+    assert "Id" not in missing_fields
+    assert "Status" not in missing_fields
+    assert "Concern" not in missing_fields
+    assert "Scope" not in missing_fields
+    assert not any(d.code == _lint.C_CHECKPOINT for d in res_yml.diagnostics)
+
+    # Fenced bullets in a plan with no bullet block and no YAML mirror must NOT leak.
+    fenced = (
+        "# IPD: Fenced bullets test\n\n"
+        "```markdown\n"
+        "- Status: approved\n"
+        "- Id: fnc001\n"
+        "- Readiness: go\n"
+        "```\n\n"
+        "## Goal\n\n"
+        "Ensure fenced bullets never leak.\n"
+    )
+    res_fenced = _lint.lint_text(fenced, checkpoint="author")
+    fenced_doc = _lint.parse(
+        fenced,
+        state=_meta.read_text(fenced, record_type="ipd"),
+        _state_from_read_text=True,
+    )
+    assert "Status" not in fenced_doc.meta_fields
+    assert "Id" not in fenced_doc.meta_fields
+    assert "Readiness" not in fenced_doc.meta_fields
+    assert any(d.code == _lint.C_META_MISSING and d.message.startswith("Status:") for d in res_fenced.diagnostics)
+
+
+def test_legacy_bullet_format_parity() -> None:
+    legacy_ok = _legacy_bullet_child()
+    res_ok = _lint.lint_text(legacy_ok, checkpoint="author", directory="pending")
+    assert res_ok.disposition == _schema.DISPOSITION_CONFORMING, res_ok.diagnostics
+
+    legacy_missing_concern = _legacy_bullet_child(omit_fields=["Concern"])
+    res_miss = _lint.lint_text(
+        legacy_missing_concern, checkpoint="author", directory="pending"
+    )
+    assert res_miss.disposition == _schema.DISPOSITION_ERROR
+    assert any(
+        d.code == _lint.C_META_MISSING and d.message.startswith("Concern:")
+        for d in res_miss.diagnostics
+    )
+
+    # Legacy bullet plan carrying Coverage + Coverage-Fingerprint without Coverage-Checked
+    # still triggers IPD-M112.
+    legacy_partial_cov = _legacy_bullet_child(
+        extra_bullets=[
+            "- Coverage: pass",
+            "- Coverage-Fingerprint: a1b2c3d4e5f6",
+        ]
+    )
+    res_cov = _lint.lint_text(
+        legacy_partial_cov, checkpoint="author", directory="pending"
+    )
+    assert any(
+        d.code == _lint.C_COVERAGE_RECORD and "Coverage-Checked" in d.message
+        for d in res_cov.diagnostics
+    )
