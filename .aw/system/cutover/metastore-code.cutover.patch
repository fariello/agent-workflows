+    rc_app, out_app, err_app = _run_cli(
+        repo,
+        [
+            "ipd",
+            "set",
+            "approved",
+            "or2000",
+            "ch2001",
+            "ch2002",
+            "--by-human",
+            "--yes",
+            "--json",
+        ],
+    )
+    assert rc_app == 0, f"batch approve failed: {out_app}\n{err_app}"
+    app_paths = [c["path"] for c in json.loads(out_app)["changes"] if c.get("applied")]
+    app_orch_idx = next(i for i, p in enumerate(app_paths) if "or2000" in p)
+    app_ch1_idx = next(i for i, p in enumerate(app_paths) if "ch2001" in p)
+    app_ch2_idx = next(i for i, p in enumerate(app_paths) if "ch2002" in p)
+    assert app_ch1_idx < app_orch_idx and app_ch2_idx < app_orch_idx, app_paths
+    _git_commit_all(repo, "approve setx")
+
+    # 3. Retiring child ch2001 with --commit appends a note to meta/or2000.jsonl and commits it
+    orch_before_bytes = orch_path.read_bytes()
+    rc_ret, out_ret, err_ret = _run_cli(
+        repo,
+        [
+            "ipd",
+            "set",
+            "superseded",
+            "ch2001",
+            "--yes",
+            "--commit",
+            "-m",
+            "replaced by ch2002",
