+def _init_log_repo(tmp_path: Path, *, name: str = "repo") -> Path:
+    repo = tmp_path / name
+    for sub in (
+        ".aw/config",
+        ".aw/state",
+        ".aw/records/meta",
+        ".aw/records/plans/pending",
+        ".aw/records/plans/executed",
+        ".aw/records/specs/to-review",
+        ".aw/records/specs/approved",
+        ".aw/records/backlog/open",
+        ".aw/records/prompts/pending",
+        ".aw/records/prompts/executed",
+        ".aw/records/reviews",
+    ):
+        (repo / sub).mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "config" / "project.json").write_text(
+        json.dumps(
+            {
+                "metadata_schema": 2,
+                "records_backend": "repository",
+                "placements": {"records": "target-tracked"},
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    return repo
+
+
+def _write_log(repo: Path, id6: str, events: list[dict]) -> Path:
+    log_path = repo / ".aw" / "records" / "meta" / f"{id6}.jsonl"
+    norm = []
+    for ev in events:
+        row = {"v": 1, **ev}
+        if row.get("by_human") is False:
+            row.pop("by_human", None)
+        norm.append(row)
+    log_path.write_text(
+        "\n".join(json.dumps(ev, separators=(",", ":")) for ev in norm) + "\n",
+        encoding="utf-8",
+    )
+    return log_path
+
+
+def _create_log_plan(
+    repo: Path,
+    id6: str,
+    *,
+    status: str = "to-review",
+    bucket: str = "pending",
+    slug: str = "sample-plan",
+    set_id: str = "demo",
+    order: int = 1,
+    priority: str | None = "medium",
+    work_kind: str | None = "bug",
+    scope_paths: list[str] | None = None,
+    item_dependencies: list[dict] | None = None,
+    body_extra: str = "",
+    extra_events: list[dict] | None = None,
+) -> Path:
+    rel = f"plans/{bucket}/20261126-{set_id}-{order:02d}-{id6}-{slug}.ipd.md"
+    plan_path = repo / ".aw" / "records" / rel
+    plan_path.parent.mkdir(parents=True, exist_ok=True)
+    mirror = meta.render_in_file_mirror(id6, "ipd", status)
+    plan_path.write_text(
+        mirror
+        + f"# IPD: {slug}\n\n"
+        + "## Goal\n\nVerify log-aware checks.\n\n"
+        + "## Open questions\n\n"
+        + (body_extra if body_extra else "None open.\n"),
+        encoding="utf-8",
+    )
+    fields: dict = {
+        "type": "ipd",
+        "status": status,
+        "plan_role": "child",
+        "set": set_id,
+        "order": order,
+        "author": "test-agent",
+        "scope_paths": scope_paths
+        if scope_paths is not None
+        else [f".aw/records/{rel}"],
+    }
+    if priority is not None:
+        fields["priority"] = priority
+    if work_kind is not None:
+        fields["work_kind"] = work_kind
+    if item_dependencies is not None:
+        fields["item_dependencies"] = item_dependencies
+    else:
+        fields["dependency_declaration"] = "none"
+    events: list[dict] = [
+        {
+            "seq": 0,
+            "append": 0,
+            "op": "checkpoint",
+            "at": "2026-11-26T10:00:00Z",
+            "actor": {"tool": "test"},
+            "path": rel,
+            "fields": fields,
+            "message": "created",
+        }
+    ]
+    if extra_events:
+        events.extend(extra_events)
+    _write_log(repo, id6, events)
+    return plan_path
+
+
+def _create_log_spec(
+    repo: Path,
+    id6: str,
+    *,
+    status: str = "to-review",
+    bucket: str = "to-review",
+    slug: str = "sample-spec",
+    extra_events: list[dict] | None = None,
+) -> Path:
+    rel = f"specs/{bucket}/20261126-{id6}-01-{id6}-{slug}.spec.md"
+    spec_path = repo / ".aw" / "records" / rel
+    spec_path.parent.mkdir(parents=True, exist_ok=True)
+    mirror = meta.render_in_file_mirror(id6, "spec", status)
+    spec_path.write_text(mirror + f"# Spec: {slug}\n\nBody.\n", encoding="utf-8")
+    events: list[dict] = [
+        {
+            "seq": 0,
+            "append": 0,
+            "op": "checkpoint",
+            "at": "2026-11-26T10:00:00Z",
+            "actor": {"tool": "test"},
+            "path": rel,
+            "fields": {"type": "spec", "status": status, "set": id6, "order": 1},
+            "message": "created",
+        }
+    ]
+    if extra_events:
+        events.extend(extra_events)
+    _write_log(repo, id6, events)
+    return spec_path
+
+
+def _render_mirror_review(
+    subject_id: str,
+    subject_type: str = "ipd",
+    *,
+    review_ref: str | None = None,
+    findings_rows: list[str] | None = None,
+    decisions_rows: list[str] | None = None,
+    include_rounds: bool = True,
+) -> str:
+    header = meta.render_review_mirror(subject_id, subject_type, review_ref=review_ref)
+    parts = [header, "# Plan Review\n"]
+    if include_rounds:
+        parts.append("## Round 1\n\n### Findings\n\n")
+        parts.append(
+            "| Id | Severity | Scope | Area | Evidence | Finding | Remediation Risk | Decision | Resolution |\n"
+            "|---|---|---|---|---|---|---|---|---|\n"
+        )
+        for row in findings_rows or []:
+            parts.append(row.rstrip("\n") + "\n")
+        parts.append("\n### Decisions\n\n")
+        parts.append(
+            "| Id | Question | Chosen | Alternatives | Basis | Reversible |\n"
+            "|---|---|---|---|---|---|\n"
+        )
+        for row in decisions_rows or []:
+            parts.append(row.rstrip("\n") + "\n")
+    return "".join(parts)
+
