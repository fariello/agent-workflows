+# 3. check_engine: check_status_untooled and check_status_untooled_range mirror flips
+# --------------------------------------------------------------------------------------
+
+
+def test_check_status_untooled_and_range_detect_mirror_flips(tmp_path: Path) -> None:
+    repo = _init_repo(tmp_path)
+    ctx = meta.legacy_context(repo)
+    plan_path = _create_log_child_plan(
+        repo, "pl0010", setid="demo", order=1, slug="mirror-test", status="to-review"
+    )
+    base_sha = _git_commit_all(repo, "add pl0010 at to-review")
+
+    # 1. Hand-edited YAML mirror intermediate flip (`to-review` -> `reviewed`) without log append
+    orig = plan_path.read_text(encoding="utf-8")
+    plan_path.write_text(
+        orig.replace("status: to-review", "status: reviewed", 1), encoding="utf-8"
+    )
+    subprocess.run(["git", "add", str(plan_path)], cwd=repo, check=True)
+    staged_drift = check_engine.check_status_untooled(repo)
+    assert [d.rule for d in staged_drift] == ["check.status-untooled"]
+
+    bad_mid_sha = _git_commit_all(repo, "hand-edit mirror to reviewed")
+    range_mid_drift = check_engine.check_status_untooled_range(
+        repo, base_sha, bad_mid_sha
+    )
+    assert [d.rule for d in range_mid_drift] == ["check.status-untooled"]
+
+    # 2. Hand-edited YAML mirror `executed` flip without log append
+    subprocess.run(["git", "reset", "--hard", "-q", base_sha], cwd=repo, check=True)
+    plan_path.write_text(
+        orig.replace("status: to-review", "status: executed", 1), encoding="utf-8"
+    )
+    subprocess.run(["git", "add", str(plan_path)], cwd=repo, check=True)
+    assert [d.rule for d in check_engine.check_status_untooled(repo)] == [
+        "check.status-untooled"
+    ]
+    bad_exec_sha = _git_commit_all(repo, "hand-edit mirror to executed")
+    assert [
+        d.rule
+        for d in check_engine.check_status_untooled_range(repo, base_sha, bad_exec_sha)
+    ] == ["check.status-untooled"]
+
+    # 3. Tooled transition via artifact_meta.append updates both log and mirror -> clean
+    subprocess.run(["git", "reset", "--hard", "-q", base_sha], cwd=repo, check=True)
+    res = meta.append(
+        "pl0010",
+        [
+            {
+                "op": "transition",
+                "from": "to-review",
+                "to": "reviewed",
+                "message": "reviewed by tool",
+            }
+        ],
+        project_context=ctx,
+        actor=_TEST_ACTOR,
+    )
+    assert res["committed"] is True
+    subprocess.run(
+        ["git", "add", str(plan_path), str(repo / ".aw/records/meta/pl0010.jsonl")],
+        cwd=repo,
+        check=True,
+    )
+    assert check_engine.check_status_untooled(repo) == []
+    good_sha = _git_commit_all(repo, "tooled transition to reviewed")
+    assert check_engine.check_status_untooled_range(repo, base_sha, good_sha) == []
+
+    # 4. Already-executed plan mirror flip is caught BEFORE is_in_executed early return
+    exec_plan = _create_log_child_plan(
+        repo,
+        "pl0011",
+        setid="demo",
+        order=2,
+        slug="already-exec",
+        status="executed",
+        disposition="executed",
+        exec_done=True,
+        valid_pass=True,
+    )
+    exec_base = _git_commit_all(repo, "add already-executed plan")
+    exec_orig = exec_plan.read_text(encoding="utf-8")
+    exec_plan.write_text(
+        exec_orig.replace("status: executed", "status: approved", 1), encoding="utf-8"
+    )
+    subprocess.run(["git", "add", str(exec_plan)], cwd=repo, check=True)
+    assert [d.rule for d in check_engine.check_status_untooled(repo)] == [
+        "check.status-untooled"
+    ]
+    exec_flip_sha = _git_commit_all(repo, "hand-edit executed plan mirror")
+    assert [
+        d.rule
+        for d in check_engine.check_status_untooled_range(repo, exec_base, exec_flip_sha)
+    ] == ["check.status-untooled"]
+
+    # 5. Corrupt log in check_status_untooled_range emits check.status-untooled fail-closed
+    subprocess.run(["git", "reset", "--hard", "-q", good_sha], cwd=repo, check=True)
+    (repo / ".aw" / "records" / "meta" / "pl0010.jsonl").write_text(
+        "{not valid json\n", encoding="utf-8"
+    )
+    plan_path.write_text(
+        plan_path.read_text(encoding="utf-8") + "\n<!-- touch -->\n", encoding="utf-8"
+    )
+    corrupt_sha = _git_commit_all(repo, "corrupt log")
+    corrupt_drift = check_engine.check_status_untooled_range(repo, good_sha, corrupt_sha)
+    assert [d.rule for d in corrupt_drift] == ["check.status-untooled"]
+
