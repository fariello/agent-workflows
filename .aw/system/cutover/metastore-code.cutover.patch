+def test_sqlite_review_projection_preserves_log_rows_and_tracks_parse_ok(
+    tmp_path: Path,
+) -> None:
+    repo = _init_log_repo(tmp_path)
+    gate_event = {
+        "seq": 1,
+        "append": 1,
+        "op": "review",
+        "at": "2026-11-26T11:00:00Z",
+        "actor": {"tool": "spec-review"},
+        "by_human": False,
+        "review_kind": "gate",
+        "round": 1,
+        "review_ref": "20261126-rev-r1",
+        "verdict": "APPROVE",
+        "observed_day": "2026-11-26",
+        "readiness": None,
+        "review_depth": "standard",
+        "findings_summary": "0 findings",
+        "reviewer": "test-reviewer",
+    }
+    _create_log_spec(repo, "sp1001", extra_events=[gate_event])
+
+    ctx = meta.legacy_context(repo)
+    # Log-sourced op: "review" is visible to query(latest_gate_review_of=...) and attestation
+    res = meta.query(latest_gate_review_of="sp1001", project_context=ctx)
+    assert [st.id6 for st in res.rows] == ["sp1001"]
+    assert rf.review_attestation_missing(repo, "sp1001", "spec") is None
+
+    # Adding a spec-4.1a .review.md with explicit ref: indexes review_files without clobbering reviews
+    rev_path = (
+        repo
+        / ".aw"
+        / "records"
+        / "reviews"
+        / "20261126-sp1001-01-xx9999-sample-spec.review.md"
+    )
+    rev_path.write_text(
+        _render_mirror_review("sp1001", "spec", review_ref="20261126-rev-r1"),
+        encoding="utf-8",
+    )
+    rows = meta.review_rows("sp1001", project_context=ctx)
+    assert len(rows) == 1
+    assert rows[0]["parse_ok"] is True
+
+    db_path = Path(ctx.logical_roots["state"]) / "index.db"
+    conn = sqlite3.connect(db_path)
+    try:
+        rf_row = conn.execute(
+            "SELECT subject_id6, review_ref, parse_ok FROM review_files WHERE subject_id6 = ?",
+            ("sp1001",),
+        ).fetchone()
+        assert rf_row == ("sp1001", "20261126-rev-r1", 1)
+        rev_rows = conn.execute(
+            "SELECT subject_id6, seq, review_ref, round, review_kind, verdict, reviewer "
+            "FROM reviews WHERE subject_id6 = ?",
+            ("sp1001",),
+        ).fetchall()
+        assert rev_rows == [
+            ("sp1001", 1, "20261126-rev-r1", 1, "gate", "APPROVE", "test-reviewer")
+        ]
+    finally:
+        conn.close()
+
+    # Removing the .review.md deletes only review_files; log-owned reviews rows survive
+    rev_path.unlink()
+    assert meta.review_rows("sp1001", project_context=ctx) == []
+    res_after_rm = meta.query(latest_gate_review_of="sp1001", project_context=ctx)
+    assert [st.id6 for st in res_after_rm.rows] == ["sp1001"]
+    assert rf.review_attestation_missing(repo, "sp1001", "spec") is None
+
+    # Malformed .review.md (missing rounds) caches parse_ok=False
+    bad_rev = (
+        repo
+        / ".aw"
+        / "records"
+        / "reviews"
+        / "20261126-sp1001-02-sp1001-broken.review.md"
