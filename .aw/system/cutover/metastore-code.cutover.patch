+def _history_entries_to_events(
+    history: Sequence[str | dict[str, Any]] | None,
+    *,
+    default_day: str,
+    default_actor: str,
+    default_readiness: str | None = None,
+) -> list[dict[str, Any]]:
+    """Convert ``history`` entries into valid ``artifact_meta`` log events."""
+    if not history:
+        return []
+    events: list[dict[str, Any]] = []
+    round_num = 1
+    for entry in history:
+        if isinstance(entry, dict):
+            if "op" in entry:
+                events.append(dict(entry))
+                if entry.get("op") == "review":
+                    round_num = max(round_num, int(entry.get("round", round_num)) + 1)
+                continue
+            day = str(entry.get("day", default_day))
+            tag = str(entry.get("tag") or entry.get("status") or "note")
+            actor = str(entry.get("actor", default_actor))
+            msg = str(
+                entry.get("message") if "message" in entry else entry.get("note", "")
+            )
+            if "review" in tag.lower():
+                rev_ev: dict[str, Any] = {
+                    "op": "review",
+                    "round": round_num,
+                    "review_kind": "gate",
+                    "observed_day": day,
+                    "reviewer": actor,
+                }
+                if msg in _meta.GATE_VERDICTS:
+                    rev_ev["verdict"] = msg
+                elif msg:
+                    rev_ev["legacy_verdict"] = msg
+                else:
+                    rev_ev["verdict"] = "APPROVE"
+                if default_readiness is not None:
+                    rev_ev["readiness"] = default_readiness
+                events.append(rev_ev)
+                round_num += 1
+            else:
+                events.append(
+                    {
+                        "op": "note",
+                        "message": f"{day} {tag} ({actor}): {msg}".strip(),
+                    }
+                )
+        elif isinstance(entry, str):
+            stripped = entry.strip()
+            if not stripped:
+                continue
+            cleaned = stripped[2:].strip() if stripped.startswith("- ") else stripped
+            m_rev = _re.match(
+                r"^(?P<day>\d{4}-\d{2}-\d{2})\s+(?P<tag>/plan-review|/spec-review|review)\s+"
+                r"\((?P<actor>[^)]+)\):\s*(?P<rest>.*)$",
+                cleaned,
+            )
+            if m_rev:
+                rest = m_rev.group("rest").strip()
+                verdict_token = rest.split(";", 1)[0].strip()
+                rev_ev = {
+                    "op": "review",
+                    "round": round_num,
+                    "review_kind": "gate",
+                    "observed_day": m_rev.group("day"),
+                    "reviewer": m_rev.group("actor").strip(),
+                }
+                if verdict_token in _meta.GATE_VERDICTS:
+                    rev_ev["verdict"] = verdict_token
+                else:
+                    rev_ev["legacy_verdict"] = verdict_token or "APPROVE"
+                if rest:
+                    rev_ev["message"] = rest
+                if default_readiness is not None:
+                    rev_ev["readiness"] = default_readiness
+                events.append(rev_ev)
+                round_num += 1
+            else:
+                events.append({"op": "note", "message": cleaned})
+        else:
+            raise TypeError(
+                f"history entry must be str or dict, got {type(entry).__name__}"
+            )
+    return events
+
