+def _create_log_child_plan(
+    repo: Path,
+    id6: str,
+    *,
+    setid: str = "demo",
+    order: int = 1,
+    slug: str = "feature",
+    status: str = "approved",
+    scope_paths: list[str] | None = None,
+    item_dependencies: Any = None,
+    disposition: str = "pending",
+    exec_done: bool = False,
+    valid_pass: bool = False,
+    project_context: Any = None,
+) -> Path:
+    ctx = project_context or meta.legacy_context(repo)
+    records_root = Path(ctx.logical_roots["records"])
+    set_slug = setid.split("(", 1)[0].strip().split()[0]
+    rel_dest = f"plans/{disposition}/20261126-{set_slug}-{order:02d}-{id6}-{slug}.ipd.md"
+    initial_status = "to-review" if status in ("reviewed", "approved") else status
+    fields: dict[str, Any] = {
+        "status": initial_status,
+        "title": f"Feature {id6}",
+        "author": "antigravity/gemini",
+        "plan_role": "child",
+        "set": setid,
+        "order": order,
+        "scope_paths": scope_paths if scope_paths is not None else ["src/feature.py"],
+        "highest_e_allocated": 1,
+        "review_depth": "standard",
+        "work_kind": "feature",
+        "priority": "medium",
+    }
+    if item_dependencies is not None:
+        fields["item_dependencies"] = item_dependencies
+    meta.create(
+        id6,
+        "ipd",
+        fields,
+        _child_plan_body(f"Feature {id6}", exec_done=exec_done, valid_pass=valid_pass),
+        destination=rel_dest,
+        project_context=ctx,
+    )
+    if status in ("reviewed", "approved"):
+        meta.append(
+            id6,
+            [
+                {
+                    "op": "review",
+                    "review_kind": "gate",
+                    "round": 1,
+                    "verdict": "APPROVE",
+                    "readiness": "go-pending-approval",
+                    "reviewer": "antigravity/gemini",
+                    "message": "reviewed",
+                },
+                {
+                    "op": "transition",
+                    "from": "to-review",
+                    "to": "reviewed",
+                    "message": "reviewed",
+                },
+            ],
+            project_context=ctx,
+            actor=_TEST_ACTOR,
+        )
+        if status == "approved":
+            meta.append(
+                id6,
+                [
+                    {
+                        "op": "transition",
+                        "from": "reviewed",
+                        "to": "approved",
+                        "message": "approved",
+                    },
+                    {
+                        "op": "set",
+                        "fields": {
+                            "approval": "2026-11-26, recorded via aw ipd set: approved"
+                        },
+                    },
+                ],
+                project_context=ctx,
+                actor=_TEST_ACTOR,
+                by_human=True,
+            )
+    return records_root / rel_dest
