+        id6="rv1001",
+        type="ipd",
+        status="to-review",
+        set_id="demo",
+        order_nn=1,
+        fields={**st_before.fields, "scope_paths": ["agent_workflows/x.py", "agent_workflows/y.py"]},
+    )
+    refused, confirm = review_sequence.structural_diff(
+        plan_text_before,
+        plan_text_before,
+        state_before=st_before,
+        state_after=st_mut,
