+def _format_log_review_citation_entry(ev: Mapping[str, Any]) -> str:
+    """Format a review log event as `- YYYY-MM-DD <mid> (<actor>): <msg>` for citations/refusals."""
+    op = ev.get("op")
+    if op == "legacy":
+        return str(ev.get("line") or "").strip()
+    raw_date = str(ev.get("observed_day") or ev.get("at") or "").strip()
+    date_part = (
+        raw_date[:10] if re.match(r"^\d{4}-\d{2}-\d{2}", raw_date) else "0000-00-00"
+    )
+    actor_obj = ev.get("actor")
+    if isinstance(actor_obj, Mapping):
+        actor_part = str(
+            actor_obj.get("tool")
+            or actor_obj.get("id")
+            or actor_obj.get("model")
+            or "review"
+        ).strip()
+    else:
+        actor_part = str(ev.get("actor_id") or "review").strip()
+    if not actor_part:
+        actor_part = "review"
+    mid = "/plan-review" if op == "review" else "reviewed"
+    verdict = str(ev.get("verdict") or ev.get("legacy_verdict") or "").strip()
+    msg = str(ev.get("message") or "").strip()
+    findings_summary = str(ev.get("findings_summary") or "").strip()
+    parts: List[str] = []
+    if verdict and msg:
+        if verdict.upper() in msg.upper():
+            parts.append(msg)
+        else:
+            parts.append(f"{verdict}; {msg}")
+    elif verdict:
+        parts.append(verdict)
+    elif msg:
+        parts.append(msg)
+    if findings_summary and findings_summary not in " ".join(parts):
+        parts.append(findings_summary)
+    return f"- {date_part} {mid} ({actor_part}): {'; '.join(parts)}"
