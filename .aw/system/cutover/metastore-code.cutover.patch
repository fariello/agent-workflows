+def test_ipd_lifecycle_nongit_precommit_fault_restores_companion_log(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    # Configure external unversioned `home` records backend so `_finalize_transaction` takes
+    # the direct-mutation non-git branch (`storage_ctx.git_root is None`).
+    aw_home = tmp_path / "aw_home"
+    aw_home.mkdir(parents=True, exist_ok=True)
+    monkeypatch.setenv("AW_HOME", str(aw_home))
+
+    repo = _init_repo(tmp_path, name="ext_repo", schema_version=None)
+    (repo / ".aw" / "config").mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "config" / "project.json").write_text(
+        json.dumps(
+            {
+                "schema_version": 2,
+                "delivery_mode": "clean-delta",
+                "records_backend": "home",
+                "metadata_schema": 2,
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    src_dir = repo / "src"
+    src_dir.mkdir(parents=True, exist_ok=True)
+    (src_dir / "feature.py").write_text("VALUE = 1\n", encoding="utf-8")
+    _git_commit_all(repo, "base commit")
+
+    ctx = meta.legacy_context(repo)
+    ext_records = Path(ctx.logical_roots["records"])
+    for sub in ("meta", "plans/pending", "plans/executed"):
+        (ext_records / sub).mkdir(parents=True, exist_ok=True)
+
+    plan_path = _create_log_child_plan(
+        repo,
+        "pl0009",
+        setid="demo",
+        order=1,
+        slug="ext-rollback",
+        status="approved",
+        scope_paths=["src/feature.py"],
+        exec_done=True,
+        valid_pass=True,
+        project_context=ctx,
+    )
+    meta_log = ext_records / "meta" / "pl0009.jsonl"
+    assert plan_path.is_file()
