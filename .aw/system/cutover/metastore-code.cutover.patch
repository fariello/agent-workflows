+def _init_repo(
+    tmp_path: Path,
+    *,
+    name: str = "repo",
+    git: bool = True,
+    schema_version: int | None = 2,
+) -> Path:
+    repo = tmp_path / name
+    repo.mkdir(parents=True, exist_ok=True)
+    if git:
+        subprocess.run(["git", "init", "-b", "main", "-q"], cwd=repo, check=True)
+        subprocess.run(["git", "config", "user.name", "Test User"], cwd=repo, check=True)
+        subprocess.run(
+            ["git", "config", "user.email", "test@example.com"], cwd=repo, check=True
+        )
+        subprocess.run(["git", "config", "commit.gpgsign", "false"], cwd=repo, check=True)
+        (repo / ".gitignore").write_text(
+            ".aw/state/\n.aw/worktrees/\n.aw/runs/\n", encoding="utf-8"
+        )
+    for sub in (
+        "meta",
+        "plans/pending",
+        "plans/executed",
+        "backlog/open",
+        "backlog/done",
+        "releases",
+        "specs",
+    ):
+        (repo / ".aw" / "records" / sub).mkdir(parents=True, exist_ok=True)
+    if schema_version is not None:
+        (repo / ".aw" / "config").mkdir(parents=True, exist_ok=True)
+        (repo / ".aw" / "config" / "project.json").write_text(
+            json.dumps(
+                {
+                    "schema_version": 2,
+                    "delivery_mode": "tracked",
+                    "records_backend": "repository",
+                    "metadata_schema": schema_version,
+                }
+            )
+            + "\n",
+            encoding="utf-8",
+        )
+    return repo
+
+
+def _git_commit_all(repo: Path, msg: str = "commit") -> str:
+    subprocess.run(["git", "add", "."], cwd=repo, check=True)
+    subprocess.run(["git", "commit", "-q", "-m", msg], cwd=repo, check=True)
+    return subprocess.check_output(
+        ["git", "rev-parse", "HEAD"], cwd=repo, text=True
+    ).strip()
+
+
+def _git_write_tree(repo: Path) -> str:
+    return subprocess.check_output(
+        ["git", "write-tree"], cwd=repo, text=True
+    ).strip()
+
