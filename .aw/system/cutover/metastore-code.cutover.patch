+def _read_release_state(
+    path: Path,
+    text: str,
+    *,
+    repo_root: Optional[Path] = None,
+) -> Tuple[Any, Optional[List[Dict[str, Any]]], Optional[str]]:
+    """Load a release record's ``(state, events, log_error)`` from its companion log if present.
+
+    Lets ``MetadataSchemaError`` propagate untouched (spec 4sd62s AC-11) and returns
+    ``(None, None, <error>)`` on corrupt-log ``ValueError`` so validators fail closed.
+    Returns ``(None, None, None)`` when no companion ``meta/<id6>.jsonl`` exists.
+    """
+    from agent_workflows import artifact_meta as _meta
+
+    id6 = _meta.read_mirror_id6(text)
+    if id6 and _core.is_valid_id6(id6):
+        records_root, owner = _resolve_release_roots(path, repo_root=repo_root)
+        if records_root is not None:
+            log_path = records_root / "meta" / f"{id6}.jsonl"
+            if log_path.is_file():
+                ctx = _records_context(records_root, owner)
+                try:
+                    with _meta.ephemeral_if_uninitialized():
+                        st = _meta.read(id6, project_context=ctx)
+                        events = _meta.history(id6, project_context=ctx)
+                    return st, events, None
+                except ValueError as exc:
+                    return None, None, str(exc)
+    return None, None, None
+
+
+def _read_release_fields_for_path(
+    path: Path, text: str, *, repo_root: Optional[Path] = None
+) -> _ReleaseFields:
+    """Read a release record's fields log-first with legacy bullet fallback."""
+    st, _events, log_error = _read_release_state(path, text, repo_root=repo_root)
+    if log_error is None and st is not None:
+        return _release_fields_from_state(st)
+    return _read_release_fields(text)
