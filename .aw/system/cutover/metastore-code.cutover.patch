+def _resolve_context_for_path(record_path: Path) -> tuple[Path, Any]:
+    """Derive ``(records_root, project_context)`` from a record file's on-disk path."""
+    resolved = record_path.resolve()
+    records_root: Path | None = None
+    repo_root: Path | None = None
+    for parent in resolved.parents:
+        if (parent / "meta").is_dir():
+            records_root = parent
+            if parent.name == "records" and parent.parent.name == ".aw":
+                repo_root = parent.parent.parent
+            elif parent.name == ".agents":
+                repo_root = parent.parent
+            else:
+                repo_root = parent.parent
+            break
+        if parent.name == "records" and parent.parent.name == ".aw":
+            records_root = parent
+            repo_root = parent.parent.parent
+            break
+        if parent.name == ".agents":
+            records_root = parent
+            repo_root = parent.parent
+            break
+    if records_root is None:
+        records_root = resolved.parent
+        repo_root = resolved.parent
+    assert repo_root is not None
+    state_root = repo_root / ".aw" / "state"
+    ctx = type(
+        "RecordBuilderContext",
+        (),
