+    ok, msg = runner_shared.check_review_lane_artifacts(repo, wt_handle, [rel_spec])
+    assert ok is True, msg
+
+    # 2. check_review_lane_artifacts with branch-only (wt_path=None)
+    br_handle = SimpleNamespace(path=None, branch="main")
+    ok_br, msg_br = runner_shared.check_review_lane_artifacts(repo, br_handle, [rel_spec])
+    assert ok_br is True, msg_br
+
+    # Branch-only invalid spec (deferred without gate) on a feature branch
+    subprocess.run(["git", "checkout", "-q", "-b", "bad-spec-lane"], cwd=repo, check=True)
+    meta.append(
+        "sp1001",
+        [{"op": "transition", "from": "draft", "to": "deferred", "message": "defer without gate"}],
+        project_context=ctx,
+    )
+    _git_commit_all(repo, "bad deferred spec")
+    subprocess.run(["git", "checkout", "-q", "main"], cwd=repo, check=True)
+
+    bad_br_handle = SimpleNamespace(path=None, branch="bad-spec-lane")
+    ok_bad, msg_bad = runner_shared.check_review_lane_artifacts(
+        repo, bad_br_handle, [rel_spec]
+    )
+    assert ok_bad is False
+    assert "attention.gate-missing" in msg_bad
+
+    # 3. enforce_freeze_time_refusal cache invalidation when meta/<id6>.jsonl changes or is deleted
+    runner_shared._FREEZE_GATE_CACHE.clear()
+    spec_abs = repo / rel_spec
+    log_path = repo / ".aw" / "records" / "meta" / "sp1001.jsonl"
+    orig_log = log_path.read_bytes()
+
+    queue = [
+        {
+            "id6": "sp1001",
+            "artifact_type": "spec",
+            "initial_status": "draft",
+            "action": "review",
+            "configured_file": rel_spec,
+            "dependencies": [],
+        }
+    ]
+    # Valid log -> passes
+    runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
+
+    # Modify meta/<id6>.jsonl to invalid priority without touching .spec.md bytes -> must fail (no stale cache hit)
+    meta.append(
+        "sp1001",
+        [{"op": "set", "fields": {"priority": "bogus-priority"}}],
+        project_context=ctx,
+    )
+    with pytest.raises(runner_shared.DriverError) as exc_mod:
+        runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
+    assert "spec.priority-invalid" in str(exc_mod.value)
+
+    # Delete meta/<id6>.jsonl -> must fail closed (no stale cache hit)
+    log_path.unlink()
+    with pytest.raises(runner_shared.DriverError) as exc_del:
+        runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
+    assert "attention.missing-status" in str(exc_del.value) or "attention.history-missing" in str(
+        exc_del.value
+    )
+
+    # Restore valid meta/<id6>.jsonl -> passes again
+    log_path.write_bytes(orig_log)
+    runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
+    assert spec_abs.is_file()
