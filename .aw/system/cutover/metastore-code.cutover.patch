+def _resolve_plan_state(
+    plan_path: Path,
+    text: str,
+    *,
+    repo_root: Optional[Path] = None,
+) -> Optional[Any]:
+    """Resolve optional companion ``artifact_meta.State`` for ``plan_path`` if a log exists.
+
+    Reads ``id6`` via ``artifact_meta.read_mirror_id6(text)`` and loads ``meta/<id6>.jsonl``
+    inside ``artifact_meta.ephemeral_if_uninitialized()``. Lets ``MetadataSchemaError``
+    propagate untouched; returns ``None`` for unlogged legacy text or an unreadable log.
+    """
+    from agent_workflows import artifact_core as _core
+    from agent_workflows import artifact_meta as _meta
+
+    id6 = _meta.read_mirror_id6(text)
+    if not id6 or not _core.is_valid_id6(id6):
+        return None
+    candidates, owner = _resolve_plan_records_roots(plan_path, repo_root=repo_root)
+    for rr in candidates:
+        log_path = rr / "meta" / f"{id6}.jsonl"
+        if log_path.is_file():
+            ctx = _records_context(rr, owner)
+            try:
+                with _meta.ephemeral_if_uninitialized():
+                    return _meta.read(id6, project_context=ctx)
+            except ValueError:
+                return None
+    return None
+
