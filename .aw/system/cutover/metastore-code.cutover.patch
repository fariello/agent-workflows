+        "mix003",
+        status="blocked",
+        extra_fields={"gate_kind": "decision", "gate_ref": "D7"},
+        slug="agents-blocked",
+    )
+
+    # 0. Without a schema-2 stamp, MetadataSchemaError propagates untouched (spec 4sd62s AC-11)
+    with pytest.raises(MetadataSchemaError):
+        backlog.validate_item(
+            agents_open, agents_open.read_text(encoding="utf-8"), repo_root=repo
+        )
+
+    # Stamp schema 2 as a migrated mixed-layout repository (spec 4sd62s C12(b))
+    cfg_dir = repo / ".aw" / "config"
+    cfg_dir.mkdir(parents=True, exist_ok=True)
+    (cfg_dir / "project.json").write_text(
+        json.dumps({"metadata_schema": 2}), encoding="utf-8"
+    )
+
+    # 1. aw backlog check validates both trees cleanly
+    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+        assert backlog.run_check(_check_args(repo)) == 0
+    assert backlog.existing_backlog_ids(repo) == {"mix001", "mix002", "mix003"}
+
+    # 2. aw backlog note appends to .agents/meta/mix002.jsonl (not .aw/records/meta/)
+    note_args = argparse.Namespace(
+        dir=str(repo),
+        path=str(agents_open),
+        selector=None,
+        message="mixed layout note recorded",
