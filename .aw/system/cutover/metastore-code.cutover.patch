+def test_partition_and_plans_log_aware_readers(tmp_path: Path) -> None:
+    repo = _init_repo(tmp_path, git=False)
+    ch1 = _create_log_child_plan(
+        repo, "ch0001", setid="beta", order=1, slug="first", status="approved"
+    )
+    ch2 = _create_log_child_plan(
+        repo,
+        "ch0002",
+        setid="beta",
+        order=2,
+        slug="second",
+        status="approved",
+        item_dependencies="executed:zz9999",
+    )
+    orch = _create_log_orchestrator_plan(
+        repo,
+        "or0001",
+        setid="beta",
+        status="approved",
+        child_rows=[(1, "ch0001", ch1.name), (2, "ch0002", ch2.name)],
+    )
+
+    # plans.read_set directly on log-format files (including descriptive "<id> (<desc>)")
+    assert plans.read_set(ch1) == ("beta", 1)
+    assert plans.read_set(ch2) == ("beta", 2)
+    assert plans.read_set(orch) == ("beta", None)
+    desc_plan = _create_log_child_plan(
+        repo,
+        "ch0003",
+        setid="delta (Delta description)",
+        order=3,
+        slug="desc-set",
+        status="approved",
+    )
+    assert plans.read_set(desc_plan) == ("delta", 3)
+
+    # plans.scan reads log-stored status, set_id, and order
+    scanned = plans.scan(repo, include_prompts=False)
+    by_name = {r.path.name: r for r in scanned}
+    assert by_name[ch1.name].status == "approved"
+    assert by_name[ch1.name].set_id == "beta"
+    assert by_name[ch1.name].order == 1
+    assert by_name[ch2.name].status == "approved"
+    assert by_name[ch2.name].set_id == "beta"
+    assert by_name[ch2.name].order == 2
+    assert by_name[orch.name].status == "approved"
+    assert by_name[orch.name].set_id == "beta"
+    assert by_name[orch.name].order is None
+    assert by_name[desc_plan.name].status == "approved"
+    assert by_name[desc_plan.name].set_id == "delta"
+    assert by_name[desc_plan.name].order == 3
+
+    # partition._is_orchestrator_plan reads log-stored plan_role
+    att_items, _ = attention.scan(repo, type_filters=("plans",))
+    att_by_id = {it.id: it for it in att_items}
+    assert partition._is_orchestrator_plan(att_by_id["or0001"], repo) is True
+    assert partition._is_orchestrator_plan(att_by_id["ch0001"], repo) is False
+    assert partition._is_orchestrator_plan(att_by_id["ch0002"], repo) is False
+
+    # partition.classify_sets resolves log-stored set id AND falls back to log-stored
+    # item_dependencies for Set members absent from pre_max_candidates (cand_by_id).
+    ch2_without_cached_deps = att_by_id["ch0002"]._replace(item_dependencies=None)
+    classifications = partition.classify_sets(
+        repo,
+        candidates=[att_by_id["or0001"], att_by_id["ch0001"], ch2_without_cached_deps],
+        pre_max_candidates=[att_by_id["or0001"], att_by_id["ch0001"]],
+        include_active=True,
+    )
+    assert "beta" in classifications
+    cs = classifications["beta"]
+    assert cs.orchestrator_id == "or0001"
+    unsat = [
+        b
+        for b in cs.blocked
+        if b.id6 == "ch0002" and b.cause == "unsatisfied-dependency"
+    ]
+    assert len(unsat) == 1
+    assert unsat[0].unsatisfied_dependencies == ("zz9999",)
+
+    # partition.expand_candidates_with_dependencies resolves prerequisite Set from log
+    consumer = _create_log_child_plan(
+        repo,
+        "co0001",
+        setid="gamma",
+        order=1,
+        slug="consumer",
+        status="approved",
+        item_dependencies="executed:ch0001",
+    )
+    assert consumer.is_file()
+    att_items2, _ = attention.scan(repo, type_filters=("plans",))
+    att_by_id2 = {it.id: it for it in att_items2}
+    expanded = partition.expand_candidates_with_dependencies(
+        repo, [att_by_id2["co0001"]], include_active=True
+    )
+    expanded_ids = {it.id for it in expanded}
+    assert {"co0001", "or0001", "ch0001", "ch0002"}.issubset(expanded_ids)
