+def test_staged_prompt_mirror_detection_parsing_and_legacy_non_corruption(
+    tmp_path: Path,
+) -> None:
+    managed = (
+        meta.render_in_file_mirror("pr1001", "prompt", "pending")
+        + "# Prompt Body\n\nAnalyze the repository.\n"
+    )
+    bom_managed = "\ufeff" + managed
+    legacy = (
+        "<!-- aw-prompt: Kind: research | Status: pending . "
+        + meta.PROMPT_METADATA_TRAILER
+        + " -->\n# Legacy Prompt\n"
+    )
+    commentless = "# Plain Prompt\n\nNo metadata comment.\n"
+    line2_comment = "# Heading\n" + managed
+
+    assert meta.has_prompt_metadata_comment(managed) is True
+    assert meta.has_prompt_metadata_comment(bom_managed) is True
+    assert meta.has_prompt_metadata_comment(legacy) is True
+    assert meta.has_prompt_metadata_comment(commentless) is False
+    assert meta.has_prompt_metadata_comment(line2_comment) is False
+
+    # parse_staged_prompt_mirror and read_text extract clean id and status without trailer
+    assert meta.parse_staged_prompt_mirror(managed) == {
+        "id": "pr1001",
+        "status": "pending",
+    }
+    assert meta.parse_staged_prompt_mirror(bom_managed) == {
+        "id": "pr1001",
+        "status": "pending",
+    }
+    for sample in (managed, bom_managed):
+        st = meta.read_text(sample, record_type="prompt")
+        assert st.id6 == "pr1001"
+        assert st.status == "pending"
+        assert st.legacy_raw_status == "pending"
+
+    # Legacy rewriters must never corrupt a post-cutover managed prompt mirror
+    assert (
+        meta.inject_prompt_metadata_id6(managed, id6="zz9999", set_id="demo") == managed
+    )
+    assert meta.update_prompt_metadata_status(managed, "executed") == managed
+    assert meta.inject_prompt_metadata_id6(bom_managed, id6="zz9999") == bom_managed
+    assert meta.update_prompt_metadata_status(bom_managed, "executed") == bom_managed
+
+    # Legacy aw-prompt rewriters still work on legacy comments
+    updated_legacy = meta.inject_prompt_metadata_id6(legacy, id6="lg1001")
+    assert "Id: lg1001" in updated_legacy
+    updated_legacy_status = meta.update_prompt_metadata_status(
+        updated_legacy, "executed"
+    )
+    assert "Status: executed" in updated_legacy_status
+
+    # Downstream callers recognize post-cutover managed prompts cleanly
+    repo = _init_log_repo(tmp_path)
+    p_dir = repo / ".aw" / "records" / "prompts" / "pending"
+    p_file = p_dir / "20261126-demo-01-pr1001-check.prompt.md"
+    p_file.write_text(bom_managed, encoding="utf-8")
+    assert "pr1001" in prompts._existing_id6s(repo / ".aw" / "records" / "prompts")
+    assert artifact_rename._read_existing_id6(p_file, "prompts") == "pr1001"
+
