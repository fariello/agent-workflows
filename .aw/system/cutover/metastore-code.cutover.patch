+def test_ipd_lifecycle_retire_orchestrator_dirty_log_and_commit(tmp_path: Path) -> None:
+    repo = _init_repo(tmp_path)
+    ctx = meta.legacy_context(repo)
+    child_path = _create_log_child_plan(
+        repo,
+        "ch0001",
+        setid="alpha",
+        order=1,
+        slug="child-one",
+        status="executed",
+        disposition="executed",
+        exec_done=True,
+        valid_pass=True,
+    )
+    orch_path = _create_log_orchestrator_plan(
+        repo,
+        "or0000",
+        setid="alpha",
+        status="approved",
+        child_rows=[(1, "ch0001", child_path.name)],
+    )
+    _git_commit_all(repo, "add alpha set with executed child")
+
+    # Dirty companion log (valid uncommitted event append while .ipd.md is clean)
+    # must be refused before rollup mutation.
+    orch_log = repo / ".aw" / "records" / "meta" / "or0000.jsonl"
+    clean_log_bytes = orch_log.read_text(encoding="utf-8")
+    meta.append(
+        "or0000",
+        [{"op": "note", "message": "uncommitted peer note"}],
+        project_context=ctx,
+        actor=_TEST_ACTOR,
+    )
+    assert orch_log.read_text(encoding="utf-8") != clean_log_bytes
+
+    refused = ipd_lifecycle.retire_orchestrator(
+        repo, orch_path, "antigravity/gemini", setid="alpha", apply=True
+    )
+    assert refused.exit_code == ipd_lifecycle.EXIT_FINDINGS, (
+        refused.message,
+        refused.findings,
+    )
+    assert ipd_lifecycle.ROLLUP_REFUSED_UNOWNED_EDIT in refused.findings
+    assert "meta/or0000.jsonl" in refused.message
+
+    # Clean companion log allows rollup retirement and commits both moved plan and meta log
+    orch_log.write_text(clean_log_bytes, encoding="utf-8")
+    retired = ipd_lifecycle.retire_orchestrator(
+        repo, orch_path, "antigravity/gemini", setid="alpha", apply=True
+    )
+    assert retired.exit_code == ipd_lifecycle.EXIT_OK, (retired.message, retired.findings)
+    assert retired.commit
+    exec_orch = repo / ".aw" / "records" / "plans" / "executed" / orch_path.name
+    assert exec_orch.is_file()
+    assert not orch_path.exists()
+
+    committed = subprocess.check_output(
+        ["git", "show", "--name-only", "--format=", "HEAD"],
+        cwd=repo,
+        text=True,
+    ).splitlines()
+    assert f".aw/records/plans/executed/{orch_path.name}" in committed
+    assert ".aw/records/meta/or0000.jsonl" in committed
+    assert meta.read("or0000", project_context=ctx).status == "executed"
+
