+def test_orchestrator_readiness_and_probe_orchestrator_on_log_format(
+    tmp_path: Path,
+) -> None:
+    """review_readiness recognizes cached log coverage, fires Condition 3 on nonconforming rows, and probe_orchestrator caches/re-probes."""
+    repo = _init_log_repo(tmp_path, with_git=True)
+    _create_log_plan(repo, "ch2001", status="to-review", order=1, slug="child-two")
+    orch_path = _create_log_plan(
+        repo,
+        "or2001",
+        status="to-review",
+        order=0,
+        plan_role="orchestrator",
+        slug="orch-two",
+        body=_orchestrator_body("ch2001"),
+    )
+    _git(repo, "add", ".aw")
+    _git(repo, "commit", "-m", "init orch two")
+
+    # Probe once via probe_orchestrator -> calls asker, writes & commits log
+    calls_seen: list[str] = []
+
+    def _asker(state: Any, excerpt: str, *, host: str, repo: Path, runner: Any = None):
+        calls_seen.append(host)
+        return (runner_shared.PROBE_ANSWER_NO_EXECUTIONS, "all work delegated", ())
+
+    target = runner_shared.ProbeTarget(
+        id6="or2001",
+        position=0,
+        setid="demo",
+        path=orch_path,
+        text=orch_path.read_text(encoding="utf-8"),
+    )
+    out1 = runner_shared.probe_orchestrator(
+        {"options": {"model": "probe-m1"}},
+        target,
+        repo=repo,
+        host="oc",
+        retry_budget=0,
+        asker=_asker,
+        commit=True,
+    )
+    assert out1.cached is False
+    assert out1.calls == 1
+    assert out1.written is True
+    assert out1.committed is True
+    assert len(calls_seen) == 1
+
+    # Second probe hits cache with 0 model calls
+    target2 = runner_shared.ProbeTarget(
+        id6="or2001",
+        position=0,
+        setid="demo",
+        path=orch_path,
+        text=orch_path.read_text(encoding="utf-8"),
+    )
+    out2 = runner_shared.probe_orchestrator(
+        {"options": {"model": "probe-m1"}},
+        target2,
+        repo=repo,
+        host="oc",
+        retry_budget=0,
+        asker=_asker,
+        commit=True,
+    )
+    assert out2.cached is True
+    assert out2.calls == 0
+    assert "probe-m1" in out2.detail
+    assert len(calls_seen) == 1
+
+    # review_readiness recognizes cached log coverage and reports ready=True
+    rr = orchestrator_readiness.review_readiness(repo, orch_path, ask=False)
+    assert rr.applies is True
+    assert rr.cached is True
+    assert rr.calls == 0
+    assert rr.ready is True
+    assert rr.findings == ()
+
+    # Nonconforming orchestrator row (work not referencing any child in ## Child IPDs) fires Condition 3 CODE_ROW_NONCONFORMING
+    bad_orch = _create_log_plan(
+        repo,
+        "or2002",
+        status="to-review",
+        order=0,
+        plan_role="orchestrator",
+        set_id="badset",
+        slug="orch-bad-row",
+        body=_orchestrator_body(
+            "ch2002",
+            e01_text="Run standalone deployment migration directly without any child.",
+        ),
+    )
+    _create_log_plan(
+        repo, "ch2002", status="to-review", order=1, set_id="badset", slug="child-bad"
+    )
+    rr_bad = orchestrator_readiness.review_readiness(repo, bad_orch, ask=False)
+    assert rr_bad.applies is True
+    codes = {f.code for f in rr_bad.findings}
+    assert orchestrator_readiness.CODE_ROW_NONCONFORMING in codes
+
