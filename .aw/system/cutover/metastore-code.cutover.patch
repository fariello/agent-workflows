+    assert any("Scope-Paths" in r for r in refused)
+    assert confirm == []
+
+    # 3. check_S5 resolves YAML mirror id without plan_path and preserves spec-4.1a YAML review mirror
+    yaml_review_unescalated = (
+        "---\n"
+        "subject: rv1001\n"
+        "subject_type: ipd\n"
+        "---\n"
+        "# Review: rv1001\n\n"
+        "## Round 1\n\n"
+        "### Findings\n\n"
+        "| Id | Severity | Scope | Area | Evidence | Finding | Remediation risk | Decision | Resolution |\n"
+        "|---|---|---|---|---|---|---|---|---|\n"
+        "| F-01 | high | in-scope | rubric | x.py:1 | Missing check | low | open | pending |\n"
+    )
+    err_s5 = review_sequence.check_S5(
+        plan_text_before,
+        plan_text_before,
+        yaml_review_unescalated,
+        "",
+        repo_root=repo,
+    )
+    assert err_s5 is not None and "review-finding-unescalated" in err_s5
+
+    plan_with_oq = meta.render_in_file_mirror("rv1001", "ipd", "to-review") + _conforming_child_body(
+        "sample-plan",
+        oq_section=(
+            "### OQ-01: Escalated finding\n"
+            "- Blocking: yes\n"
+            "- Status: open\n"
+            "- Finding: F-01\n"
+        ),
+    )
+    assert (
+        review_sequence.check_S5(
+            plan_text_before,
+            plan_with_oq,
+            yaml_review_unescalated,
+            "",
+            repo_root=repo,
+        )
+        is None
+    )
+
+    # Malformed YAML review header must fail closed (not be masked by injected legacy bullets)
+    malformed_yaml_review = (
+        "---\n"
+        "subject: invalid!\n"
+        "---\n"
+        "# Review: malformed\n\n"
+        "## Round 1\n\n"
+        "### Findings\n\n"
