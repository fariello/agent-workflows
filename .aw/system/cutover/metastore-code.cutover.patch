+def test_research_mv_and_set_assign_atomic_rename_companion_and_commit(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    repo = _init_log_repo(tmp_path, name="refs-repo")
+    rroot = repo / ".aw" / "records" / "research"
+    ctx = meta.legacy_context(repo)
+
+    # Seed two research records through aw research new --apply
+    rc1, o1, e1 = _run_cli(
+        repo,
+        [
+            "research",
+            "new",
+            "--kind",
+            "notes",
+            "--slug",
+            "orig-one",
+            "--summary",
+            "First research note",
+            "--set",
+            "oldset",
+            "--order",
+            "1",
+            "--topic",
+            "t1",
+            "--date",
+            "20261120",
+            "--apply",
+        ],
+    )
+    assert rc1 == 0, f"{o1}\n{e1}"
+    rc2, o2, e2 = _run_cli(
+        repo,
+        [
+            "research",
+            "new",
+            "--kind",
+            "findings",
+            "--slug",
+            "orig-two",
+            "--summary",
+            "Second research note",
+            "--set",
+            "oldset",
+            "--order",
+            "2",
+            "--topic",
+            "t2",
+            "--date",
+            "20261120",
+            "--apply",
+        ],
+    )
+    assert rc2 == 0, f"{o2}\n{e2}"
+
+    entries, drift = ri._scan_docs(rroot)
+    assert drift == []
+    by_order = {e.order: e for e in entries}
+    id1 = by_order["01"].id6
+    id2 = by_order["02"].id6
+
+    # Attach a companion directory to doc 2 before committing seed state
+    doc2 = _find_research_doc(repo, id2)
+    comp2 = R.companion_dir_for(doc2)
+    comp2.mkdir(parents=True)
+    (comp2 / "figure.txt").write_text("chart data\n", encoding="utf-8")
+    _git_commit_all(repo, "seed research records")
+
+    # 1. Slug-only rename (empty event_fields): must still emit op="rename" and update state.path
+    p_slug, err_slug = rrefs.plan_mv(
+        rroot, id1, slug="renamed-slug", repo_root=repo
+    )
+    assert err_slug is None and p_slug is not None
+    mr_slug = rrefs._apply_renames(
+        repo, [p_slug], apply=True, verb="rename", emit_human=False
+    )
+    assert mr_slug is not None and mr_slug.rc == 0
+    assert f".aw/records/meta/{id1}.jsonl" in mr_slug.touched_paths
+    assert not p_slug.old_path.exists() and p_slug.new_path.exists()
+    st1 = meta.read(id1, project_context=ctx)
+    assert st1.path == f"research/{p_slug.new_path.name}"
+    hist1 = meta.history(id1, project_context=ctx)
+    rename_evs = [ev for ev in hist1 if ev.get("op") == "rename"]
+    assert len(rename_evs) == 1
+    assert rename_evs[0]["path"] == f"research/{p_slug.new_path.name}"
+
+    # 2. Same-path no-op rename: must NOT append op="rename" and touched_paths stays empty
+    p_noop, err_noop = rrefs.plan_mv(
+        rroot, id1, slug="renamed-slug", repo_root=repo
+    )
+    assert err_noop is None and p_noop is not None
+    assert p_noop.old_path == p_noop.new_path
+    mr_noop = rrefs._apply_renames(
+        repo, [p_noop], apply=True, verb="rename", emit_human=False
+    )
+    assert mr_noop is not None and mr_noop.rc == 0
+    assert mr_noop.touched_paths == ()
+    hist1_after_noop = meta.history(id1, project_context=ctx)
+    assert len([ev for ev in hist1_after_noop if ev.get("op") == "rename"]) == 1
+
+    # 3. aw research mv --model --kind --apply, then aw rename research --order --apply
+    rc_mv, o_mv, e_mv = _run_cli(
+        repo,
+        [
+            "research",
+            "mv",
+            id1,
+            "--model",
+            "gpt-56",
+            "--kind",
+            "research-report",
+            "--apply",
+            "--no-commit",
+        ],
+    )
+    assert rc_mv == 0, f"mv failed: {o_mv}\n{e_mv}"
+    rc_ord, o_ord, e_ord = _run_cli(
+        repo,
+        [
+            "rename",
+            "research",
+            id1,
+            "--order",
+            "5",
+            "--apply",
+            "--no-commit",
+        ],
+    )
+    assert rc_ord == 0, f"rename --order failed: {o_ord}\n{e_ord}"
+    doc1_new = _find_research_doc(repo, id1)
+    st1_mv = meta.read(id1, project_context=ctx)
+    assert st1_mv.path == f"research/{doc1_new.name}"
+    assert st1_mv.order_nn == 5
+    assert st1_mv.fields["model"] == "gpt56"
+    assert st1_mv.fields["research_kind"] == "research-report"
+
+    # Zero name-frontmatter-mismatch drift after mv
+    _, drift_mv = ri._scan_docs(rroot)
+    assert drift_mv == [], f"drift after mv: {drift_mv}"
+    _git_commit_all(repo, "commit mv changes")
+
+    # 4. aw research set-assign --set --order --date --apply --commit (with companion dir)
+    rc_sa, o_sa, e_sa = _run_cli(
+        repo,
+        [
+            "research",
+            "set-assign",
+            id1,
+            id2,
+            "--set",
+            "newset",
+            "--order",
+            "10",
+            "--date",
+            "20261126",
+            "--apply",
+            "--commit",
+        ],
+    )
+    assert rc_sa == 0, f"set-assign failed: {o_sa}\n{e_sa}"
+
+    doc1_sa = _find_research_doc(repo, id1)
+    doc2_sa = _find_research_doc(repo, id2)
+    st1_sa = meta.read(id1, project_context=ctx)
+    st2_sa = meta.read(id2, project_context=ctx)
+    assert st1_sa.set_id == "newset" and st1_sa.order_nn == 10
+    assert st1_sa.path == f"research/{doc1_sa.name}"
+    assert st2_sa.set_id == "newset" and st2_sa.order_nn == 11
+    assert st2_sa.path == f"research/{doc2_sa.name}"
+    # Companion directory moved alongside doc 2
+    new_comp2 = R.companion_dir_for(doc2_sa)
+    assert not comp2.exists()
+    assert (new_comp2 / "figure.txt").read_text(encoding="utf-8") == "chart data\n"
+    # Companion logs committed by --commit
+    committed = _git_last_commit_files(repo)
+    assert f".aw/records/meta/{id1}.jsonl" in committed
+    assert f".aw/records/meta/{id2}.jsonl" in committed
+    # Clean index scan
+    _, drift_sa = ri._scan_docs(rroot)
+    assert drift_sa == [], f"drift after set-assign: {drift_sa}"
+
+    # 5. Pre-validation atomicity on multi-id set-assign: if the 2nd item fails dry_run,
+    # the 1st item is completely untouched (file, log, and companion dir).
+    plans_batch, err_batch = rrefs.plan_set_assign(
+        rroot, [id1, id2], "atomset", "20261126", start_order=20, repo_root=repo
+    )
+    assert err_batch is None and plans_batch is not None and len(plans_batch) == 2
+    orig_append = meta.append
+
+    def _fail_second_dry_run(id6_arg, events_arg, **kwargs):
+        if kwargs.get("dry_run") and id6_arg == id2:
+            raise ValueError("simulated pre-validation failure on second item")
+        return orig_append(id6_arg, events_arg, **kwargs)
+
+    monkeypatch.setattr(meta, "append", _fail_second_dry_run)
+    with pytest.raises(ValueError, match="simulated pre-validation failure"):
+        rrefs._apply_renames(
+            repo, plans_batch, apply=True, verb="group", emit_human=False
+        )
+    # Neither file nor companion dir moved
+    assert doc1_sa.exists() and doc2_sa.exists()
+    assert not plans_batch[0].new_path.exists() and not plans_batch[1].new_path.exists()
+    assert meta.read(id1, project_context=ctx).set_id == "newset"
+
+    # 6. Non-swallowed append warning/failure in _apply_renames
+    p_bad1, _ = rrefs.plan_mv(rroot, id1, slug="should-not-move", repo_root=repo)
+    assert p_bad1 is not None
+
+    def _warn_append(id6_arg, events_arg, **kwargs):
+        if kwargs.get("dry_run"):
+            return orig_append(id6_arg, events_arg, **kwargs)
+        return {"committed": True, "warning": "change recorded; run repair (step 3 failed)"}
+
+    monkeypatch.setattr(meta, "append", _warn_append)
