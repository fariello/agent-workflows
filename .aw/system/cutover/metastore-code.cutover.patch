+def _companion_meta_log_path(plans_dir: Path, plan_id: str) -> Optional[Path]:
+    """Return ``<records_root>/meta/<plan_id>.jsonl`` if present beside ``plans_dir``."""
+    if not plan_id:
+        return None
+    cand = plans_dir.parent / "meta" / f"{plan_id}.jsonl"
+    return cand if cand.is_file() else None
