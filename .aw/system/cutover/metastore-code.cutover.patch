+"""Core behavioral tests for log-aware coverage_record, readiness, runner helpers, and review-sequence evaluators (q6fiws)."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from agent_workflows import (
+    artifact_meta as meta,
+    coverage_record,
+    orchestrator_readiness,
+    plan_readiness,
+    review_rereview,
+    review_sequence,
+    review_tier,
+    runner_shared,
+)
+
+pytestmark = pytest.mark.core
+
+
+def _git(repo: Path, *args: str) -> str:
+    proc = subprocess.run(
+        ["git", *args],
+        cwd=str(repo),
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return proc.stdout.strip()
+
+
+def _init_log_repo(tmp_path: Path, *, name: str = "repo", with_git: bool = False) -> Path:
+    repo = tmp_path / name
+    for sub in (
+        ".aw/config",
+        ".aw/state",
+        ".aw/records/meta",
+        ".aw/records/plans/pending",
+        ".aw/records/plans/executed",
+        ".aw/records/specs/to-review",
+        ".aw/records/specs/approved",
+        ".aw/records/backlog/open",
+        ".aw/records/reviews",
+    ):
+        (repo / sub).mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "config" / "project.json").write_text(
+        json.dumps(
+            {
+                "metadata_schema": 2,
+                "records_backend": "repository",
+                "placements": {"records": "target-tracked"},
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    if with_git:
+        _git(repo, "init", "-b", "main")
+        _git(repo, "config", "user.name", "Test User")
+        _git(repo, "config", "user.email", "test@example.com")
+    return repo
