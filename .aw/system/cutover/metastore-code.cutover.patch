+def test_production_commit_helpers_include_companion_meta_logs_and_reject_unrelated(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, kind: str
+) -> None:
+    """E-03 (tjfc7p): production commit helpers commit companion meta logs and report unrelated files/logs out_of_scope."""
+    aw_home = tmp_path / "aw_home"
+    aw_home.mkdir()
+    monkeypatch.setenv("AW_HOME", str(aw_home))
+
+    repo = _bare_records_repo(tmp_path / f"prod_{kind}_repo")
+    rb = RecordBuilder(repo)
+    rb.plan(id6="bs5001", set="pset51", order=1, status="to-review", title="Baseline")
+    cont_p = Path(
+        rb.plan(
+            id6="cn5001",
+            set="pset51",
+            order=2,
+            status="to-review",
+            title="Continued Plan",
+        )
+    )
+    _git_commit_all(repo, "baseline plans")
+
+    # Produce a brand-new plan (writes both .ipd.md and meta/nw5001.jsonl)
+    new_p = Path(
+        rb.plan(
+            id6="nw5001",
+            set="pset51",
+            order=3,
+            status="to-review",
+            title="Newly Produced Plan",
+        )
+    )
+    # Modify continued plan markdown and its companion meta log
+    cont_p.write_text(
+        cont_p.read_text(encoding="utf-8") + "\nAdditional detail.\n",
+        encoding="utf-8",
+    )
+    cont_log = repo / ".aw" / "records" / "meta" / "cn5001.jsonl"
+    cont_log.write_text(
+        cont_log.read_text(encoding="utf-8") + '{"note":"continued"}\n',
+        encoding="utf-8",
+    )
+    # Add an unrelated file, an unrelated meta log, and a `.aw/state/` runtime file
+    unrelated = repo / "unrelated_note.txt"
+    unrelated.write_text("do not commit\n", encoding="utf-8")
+    unrelated_meta = repo / ".aw" / "records" / "meta" / "ot9999.jsonl"
+    unrelated_meta.write_text('{"id":"ot9999"}\n', encoding="utf-8")
+    state_copy = repo / ".aw" / "state" / "lane-inputs" / "rev-1" / "meta" / "nw5001.jsonl"
+    state_copy.parent.mkdir(parents=True, exist_ok=True)
+    state_copy.write_text('{"state":"ignored"}\n', encoding="utf-8")
+
+    commit_fn = (
+        runner_shared.commit_spec_production_output
+        if kind == "spec"
+        else runner_shared.commit_backlog_production_output
+    )
+    sha, committed, out_of_scope = commit_fn(
+        repo,
+        "sp5001" if kind == "spec" else "bk5001",
+        {"bs5001", "cn5001"},
+        host_label="agy",
+        run_id="run-test-tjfc7p",
+        continued_plan_ids={"cn5001"},
+    )
+
+    assert sha is not None
+    expected_committed = {
+        new_p.relative_to(repo).as_posix(),
+        ".aw/records/meta/nw5001.jsonl",
+        cont_p.relative_to(repo).as_posix(),
+        ".aw/records/meta/cn5001.jsonl",
+    }
+    assert set(committed) == expected_committed
+    assert set(out_of_scope) == {
+        "unrelated_note.txt",
+        ".aw/records/meta/ot9999.jsonl",
+    }
+
+    head_files = _head_files(repo)
+    assert expected_committed.issubset(head_files)
+    assert "unrelated_note.txt" not in head_files
+    assert ".aw/records/meta/ot9999.jsonl" not in head_files
+    assert not any(p.startswith(".aw/state/") for p in head_files)
+
+    # Guard: deleted continued meta log must be flagged out_of_scope, not committed.
+    cont_log.unlink()
+    sha_del, committed_del, oos_del = commit_fn(
+        repo,
+        "sp5001" if kind == "spec" else "bk5001",
+        {"bs5001", "cn5001", "nw5001"},
+        host_label="agy",
+        run_id="run-test-tjfc7p",
+        continued_plan_ids={"cn5001"},
+    )
+    assert sha_del is None
+    assert committed_del == ()
+    assert ".aw/records/meta/cn5001.jsonl" in oos_del
+
