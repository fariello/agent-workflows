+"""Core behavioral tests for log-aware selectors and artifact_rename --to-id6 (j1f454)."""
+
+from __future__ import annotations
+
+import argparse
+import io
+import json
+import subprocess
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+
+import pytest
+
+from agent_workflows import artifact_meta as meta
+from agent_workflows import artifact_rename, cli, selectors
+
+pytestmark = pytest.mark.core
+
+
+def _init_log_repo(tmp_path: Path, *, name: str = "repo", git: bool = False) -> Path:
+    repo = tmp_path / name
+    for sub in (
+        ".aw/config",
+        ".aw/state",
+        ".aw/records/meta",
+        ".aw/records/plans/pending",
+        ".aw/records/plans/executed",
+        ".aw/records/specs/to-review",
+        ".aw/records/specs/approved",
+        ".aw/records/backlog/open",
+        ".aw/records/research",
+        ".aw/records/releases",
+        ".aw/records/prompts/pending",
+        ".aw/records/walkthroughs",
+        ".aw/records/reviews",
+    ):
+        (repo / sub).mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "config" / "project.json").write_text(
+        json.dumps(
+            {
+                "metadata_schema": 2,
+                "records_backend": "repository",
+                "placements": {"records": "target-tracked"},
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    if git:
+        subprocess.run(["git", "init", "-q"], cwd=repo, check=True)
+        subprocess.run(["git", "config", "user.email", "t@e.com"], cwd=repo, check=True)
+        subprocess.run(["git", "config", "user.name", "Test"], cwd=repo, check=True)
+    return repo
+
+
+def _git_commit_all(repo: Path, msg: str = "fixture") -> None:
+    subprocess.run(["git", "add", "-A"], cwd=repo, check=True)
+    subprocess.run(["git", "commit", "-q", "-m", msg], cwd=repo, check=True)
+
+
+def _create_log_record(
+    repo: Path,
+    id6: str,
+    art_type: str,
+    rel_path: str,
+    fields: dict,
+    body: str,
+    *,
+    bom: bool = False,
+) -> Path:
+    ctx = meta.legacy_context(repo)
+    res = meta.create(
+        id6,
+        art_type,
+        fields,
+        body,
+        destination=rel_path,
+        dry_run=False,
+        overwrite=True,
+        project_context=ctx,
+        actor={"tool": "test"},
+    )
+    assert res.get("committed") is True, res
+    path = repo / ".aw" / "records" / rel_path
+    if bom:
+        path.write_text("\ufeff" + path.read_text(encoding="utf-8"), encoding="utf-8")
+    return path
+
+
+def _run_cli(repo: Path, argv: list[str]) -> tuple[int, str, str]:
+    out, err = io.StringIO(), io.StringIO()
+    with redirect_stdout(out), redirect_stderr(err):
+        try:
+            rc = cli.main([*argv, "--dir", str(repo)])
+        except SystemExit as exc:
+            rc = int(exc.code or 0)
+    return rc, out.getvalue(), err.getvalue()
+
+
+def test_selectors_resolve_and_aw_find_status_across_log_format_types(
+    tmp_path: Path,
+) -> None:
+    repo = _init_log_repo(tmp_path)
+
+    p_plan = _create_log_record(
