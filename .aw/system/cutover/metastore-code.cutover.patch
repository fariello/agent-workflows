+    assert rc_refuse == 1, f"expected refusal, got rc={rc_refuse}: {out_refuse}\n{err_refuse}"
+    assert "not ready" in (out_refuse + err_refuse).lower()
+
+    # 2. Promoting orchestrator AND draft child together (orchestrator listed FIRST) succeeds via
+    # sibling `status_overrides` AND sorts children before orchestrator in write order!
+    rc_ok, out_ok, err_ok = _run_cli(
+        repo,
+        [
+            "ipd",
+            "set",
+            "to-review",
+            "or2000",
+            "ch2001",
