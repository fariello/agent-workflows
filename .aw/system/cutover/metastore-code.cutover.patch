+    assert any(
+        ev.get("op") == "note" and "child ch2001 retired superseded" in str(ev.get("message", ""))
+        for ev in orch_hist
+    ), orch_hist
+    committed = _git_last_commit_files(repo)
+    assert ".aw/records/meta/or2000.jsonl" in committed, committed
+    assert ".aw/records/meta/ch2001.jsonl" in committed, committed
+
+    # 4. Dirty orchestrator companion log (while orch.path .ipd.md is clean) skips orchestrator note
+    orch_log = repo / ".aw" / "records" / "meta" / "or2000.jsonl"
+    prior_hist_len = len(orch_hist)
+    dirty_event = {
+        "v": 1,
+        "seq": prior_hist_len,
+        "append": prior_hist_len,
+        "op": "note",
+        "at": "2026-11-26T12:00:00Z",
+        "actor": {"tool": "manual"},
+        "message": "uncommitted manual note",
+    }
+    orch_log.write_text(
+        orch_log.read_text(encoding="utf-8") + json.dumps(dirty_event) + "\n",
+        encoding="utf-8",
+    )
+    rc_ret2, out_ret2, err_ret2 = _run_cli(
+        repo,
+        ["ipd", "set", "not-executed", "ch2002", "--yes", "-m", "dropped"],
+    )
+    assert rc_ret2 == 0, f"child 2 retire failed: {out_ret2}\n{err_ret2}"
+    assert "uncommitted changes" in (out_ret2 + err_ret2).lower()
+    with meta.ephemeral_if_uninitialized():
+        orch_hist2 = meta.history("or2000", project_context=ctx)
+    assert not any(
+        "child ch2002 retired" in str(ev.get("message", "")) for ev in orch_hist2
+    ), orch_hist2
+
+    # 5. Hot status on a log-format research-prompt (without .research-prompt.md suffix or inline kind) is refused
+    prompt_rel = "research/20261126-rp01-00-rp3001-prompt-doc.md"
+    prompt_path = repo / ".aw" / "records" / prompt_rel
+    prompt_path.write_text(
+        meta.render_in_file_mirror("rp3001", "research", None)
+        + "# Prompt Document\n\nBody without inline kind.\n",
+        encoding="utf-8",
+    )
+    _write_log(
+        repo,
+        "rp3001",
+        [
+            {
+                "seq": 0,
+                "append": 0,
+                "op": "checkpoint",
+                "at": "2026-11-26T10:00:00Z",
+                "actor": {"tool": "test"},
+                "path": prompt_rel,
+                "fields": {
+                    "type": "research",
+                    "created": "20261126",
+                    "set": "rp01",
+                    "order": 0,
+                    "topic": [],
+                    "model": None,
+                    "research_kind": "research-prompt",
+                    "outcome": "none-yet",
+                    "summary": "Prompt doc",
+                    "consumed_by": [],
+                },
+                "message": "created",
+            }
+        ],
+    )
+    rc_rp, out_rp, err_rp = _run_cli(
+        repo, ["set", "research", "active", "rp3001", "--yes"]
+    )
+    assert rc_rp != 0, f"expected refusal for research-prompt hot status: {out_rp}\n{err_rp}"
+    assert "research-prompt carries no hot status" in (out_rp + err_rp)
