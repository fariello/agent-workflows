+def test_planned_file_compat_bom_status_none_and_uncommitted_error(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    repo = _init_log_repo(tmp_path, name="compat-repo")
+    rroot = repo / ".aw" / "records" / "research"
+    ctx = meta.legacy_context(repo)
+
+    # plan_new and plan_new_comparison populate PlannedFile.fields and PlannedFile.id6
+    planned_list, err = rcmd.plan_new(
+        research_root=rroot,
+        kind="findings",
+        slug="alpha-study",
+        summary="Alpha study summary",
+        short_description="Alpha short desc",
+        set_id="salpha",
+        model="gpt-56",
+        topic=["alpha"],
+        date_str="20261126",
+        priority="medium",
+        order=1,
+    )
+    assert err is None and planned_list is not None and len(planned_list) == 1
+    pf = planned_list[0]
+    assert pf.id6 is not None and len(pf.id6) == 6
+    assert pf.fields is not None
+    assert pf.fields["created"] == "20261126"
+    assert pf.fields["set"] == "salpha"
+    assert pf.fields["order"] == 1
+    assert pf.fields["topic"] == ["alpha"]
+    assert pf.fields["model"] == "gpt56"
+    assert pf.fields["research_kind"] == "findings"
+    assert pf.fields["status"] == "todo"
+    assert pf.fields["priority"] == "medium"
+    assert pf.fields["short_description"] == "Alpha short desc"
+
+    cmp_list, cmp_err = rcmd.plan_new_comparison(
+        research_root=rroot,
+        set_id="scmp",
+        slug="beta",
+        models=["gpt-56"],
+        summary="Beta compare",
+        topic=["beta"],
+        date_str="20261126",
+    )
+    assert cmp_err is None and cmp_list is not None and len(cmp_list) == 3
+    assert all(p.fields is not None and p.id6 is not None for p in cmp_list)
+    assert "status" not in (cmp_list[0].fields or {})
+
+    # 2-arg PlannedFile(path, content) backward compatibility with UTF-8 BOM + full frontmatter
+    legacy_path = rroot / "20261126-leg01-01-leg101-legacy-compat.notes.md"
+    legacy_fm = rcmd.build_frontmatter(
+        id6="leg101",
+        created="20261126",
+        set_id="leg01",
+        order="01",
+        topic=["compat"],
+        model=None,
+        kind="notes",
+        status="todo",
+        outcome="none-yet",
+        summary="Legacy two-arg caller",
+        consumed_by=[],
+        priority="low",
+    )
+    two_arg = rcmd.PlannedFile(legacy_path, "\ufeff" + legacy_fm + "# Body\nHello.\n")
+    assert two_arg.fields is None and two_arg.id6 is None
+    rcmd._write_planned_research_file(two_arg, research_root=rroot, overwrite=False)
+    st_leg = meta.read("leg101", project_context=ctx)
+    assert st_leg.status == "todo"
+    assert st_leg.fields["set"] == "leg01"
+    assert st_leg.fields["order"] == 1
+    assert st_leg.fields["priority"] == "low"
+    assert st_leg.fields["summary"] == "Legacy two-arg caller"
+    leg_text = legacy_path.read_text(encoding="utf-8")
+    assert leg_text.count("aw-managed:") == 1
+    assert "# Body\nHello.\n" in leg_text
+
+    # PlannedFile with explicit status: None and leading BOM + existing mirror/banner
+    prompt_path = rroot / "20261126-prm01-00-prm202-bom-prompt.research-prompt.md"
+    raw_fields = {
+        "created": "20261126",
+        "set": "prm01",
+        "order": 0,
+        "topic": ["bom"],
+        "model": None,
+        "research_kind": "research-prompt",
+        "status": None,
+        "outcome": "none-yet",
+        "summary": "Statusless prompt with None status key",
+        "consumed_by": [],
+    }
+    bom_mirror = (
+        "\ufeff---\nid: prm202\n---\n"
+        "<!-- aw-managed: metadata lives in .aw/records/meta/prm202.jsonl; do not edit front matter by hand -->\n"
+        "# Prompt Body\n"
+    )
+    pf_none = rcmd.PlannedFile(prompt_path, bom_mirror, fields=raw_fields, id6="prm202")
+    rcmd._write_planned_research_file(pf_none, research_root=rroot, overwrite=False)
+    # Caller's original dict was copied, not mutated
+    assert "status" in raw_fields
+    st_prm = meta.read("prm202", project_context=ctx)
+    assert st_prm.status is None
+    prm_create_fields = meta.history("prm202", project_context=ctx)[0]["fields"]
+    assert "status" not in prm_create_fields
+    prm_text = prompt_path.read_text(encoding="utf-8")
+    assert prm_text.count("aw-managed:") == 1
+    assert "status:" not in prm_text
+    assert prm_text.endswith("# Prompt Body\n")
+
+    # Uncommitted _meta.create must raise RuntimeError (and exit non-zero through _emit_and_write)
+    monkeypatch.setattr(
+        meta,
+        "create",
+        lambda *a, **kw: {"committed": False, "error": "simulated write refusal"},
+    )
+    with pytest.raises(RuntimeError, match="simulated write refusal"):
+        rcmd._write_planned_research_file(pf, research_root=rroot, overwrite=False)
+    rc_fail = rcmd._emit_and_write([pf], apply=True, overwrite=False)
+    assert rc_fail == 2
+
