+def _normalize_status_path(p_str: str) -> str:
+    """Normalize a git status path to POSIX form without stripping leading dotfiles such as `.aw/`."""
+    norm_p = p_str.replace("\\", "/").strip()
+    while norm_p.startswith("./"):
