+"""Core behavioral tests for log-aware backlog validation, readers, and production callers (fljn9b)."""
+
+from __future__ import annotations
+
+import argparse
+import io
+import json
+import subprocess
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+import pytest
+
+from agent_workflows import (
+    artifact_core as core,
+    artifact_meta as meta,
+    backlog,
+    check_engine,
+    runner_shared,
+    set_records,
+)
+from tests.support import coordinator_role
+
+pytestmark = pytest.mark.core
+
+
+def _init_git_repo(root: Path, *, with_release: bool = False) -> Path:
+    repo = root / "repo"
+    repo.mkdir(parents=True, exist_ok=True)
+    subprocess.run(["git", "init", "-b", "main", "-q"], cwd=repo, check=True)
+    subprocess.run(["git", "config", "user.name", "Test User"], cwd=repo, check=True)
+    subprocess.run(
+        ["git", "config", "user.email", "test@example.com"], cwd=repo, check=True
+    )
+    subprocess.run(["git", "config", "commit.gpgsign", "false"], cwd=repo, check=True)
+    (repo / ".gitignore").write_text(
+        ".aw/state/\n.aw/worktrees/\n.aw/runs/\n", encoding="utf-8"
+    )
+    (repo / ".aw" / "records" / "backlog" / "open").mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "records" / "plans" / "pending").mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "records" / "meta").mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "records" / "backlog" / "open" / ".gitkeep").write_text(
+        "", encoding="utf-8"
+    )
+    (repo / ".aw" / "records" / "plans" / "pending" / ".gitkeep").write_text(
+        "", encoding="utf-8"
+    )
+    if with_release:
+        rel_dir = repo / ".aw" / "records" / "releases"
+        rel_dir.mkdir(parents=True, exist_ok=True)
+        ctx = meta.legacy_context(repo)
+        meta.create(
+            "rel001",
+            "release",
+            {
+                "status": "planned",
+                "set": "rel001",
+                "order": 1,
+                "version": "1.0.0",
+                "short_description": "Release 1.0.0",
+            },
+            "\n# Release 1.0.0\n",
+            destination="releases/20261127-rel001-01-rel001-v1.release.md",
+            dry_run=False,
+            project_context=ctx,
+            actor={"tool": "test"},
+            message="create release",
+        )
+    subprocess.run(["git", "add", "."], cwd=repo, check=True)
+    subprocess.run(["git", "commit", "-qm", "initial commit"], cwd=repo, check=True)
+    return repo
+
+
+def _new_backlog_args(repo: Path, **overrides) -> argparse.Namespace:
+    defaults = {
+        "dir": str(repo),
+        "status": "open",
+        "set": None,
+        "priority": "high",
+        "work_kind": "chore",
+        "kind": None,
+        "summary": "Default summary for log-format test",
+        "slug": None,
+        "gate_kind": None,
+        "gate_ref": None,
+        "blocks_release": None,
+        "release_exempt_kind": None,
+        "release_exempt_ref": None,
+        "message": None,
+        "body": "",
+        "apply": True,
+        "agent": False,
+        "json": False,
+    }
+    defaults.update(overrides)
+    return argparse.Namespace(**defaults)
+
+
+def _check_args(repo: Path, *, as_json: bool = False) -> argparse.Namespace:
+    return argparse.Namespace(
+        dir=str(repo),
+        agent=False,
+        json=as_json,
+        no_color=True,
+    )
+
+
+def _create_log_backlog(
+    records_root: Path,
+    owner_repo: Path,
+    id6: str,
+    *,
+    status: str = "open",
+    set_id: str = "demo",
+    priority: str = "high",
+    work_kind: str = "chore",
+    summary: str | None = "Log-backed summary",
+    short_description: str | None = None,
+    body: str = "\nBody prose.\n",
+    extra_fields: dict | None = None,
+    slug: str = "item",
+) -> Path:
+    ctx = backlog._records_context(records_root, owner_repo)
+    fields: dict = {
+        "status": status,
+        "set": set_id,
+        "priority": priority,
+        "work_kind": work_kind,
+    }
+    if summary is not None:
+        fields["summary"] = summary
+    if short_description is not None:
+        fields["short_description"] = short_description
+    elif summary is not None:
+        fields["short_description"] = summary
+    if extra_fields:
+        fields.update(extra_fields)
+    rel_dest = f"backlog/{status}/20261127-{set_id}-01-{id6}-{slug}.backlog.md"
+    res = meta.create(
+        id6,
+        "backlog",
+        fields,
+        body,
+        destination=rel_dest,
+        dry_run=False,
+        project_context=ctx,
+        actor={"tool": "test"},
+        message="created in test",
+    )
+    assert res.get("committed") is True
+    return Path(res["destination"])
+
+
+def test_backlog_new_emits_writing_standard_pointer_once_and_survives_set(
+    tmp_path: Path,
+) -> None:
+    repo = _init_git_repo(tmp_path)
+    pointer = core.writing_standard_pointer("backlog item")
+
+    # 1. Dry-run emits pointer once without creating files
+    dry_out = io.StringIO()
+    with redirect_stdout(dry_out), redirect_stderr(io.StringIO()):
+        rc = backlog.run_new(
+            _new_backlog_args(
+                repo,
+                summary="Dry-run pointer check",
+                body="Extra context paragraph.\n",
+                apply=False,
+            )
+        )
+    assert rc == 0
+    assert dry_out.getvalue().count(pointer) == 1
+    assert list((repo / ".aw" / "records" / "backlog" / "open").glob("*.backlog.md")) == []
+
+    # 2. Apply with empty body emits pointer once
+    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+        rc = backlog.run_new(
+            _new_backlog_args(repo, summary="Empty body pointer check", body="", apply=True)
+        )
+    assert rc == 0
+    created_files = sorted(
+        (repo / ".aw" / "records" / "backlog" / "open").glob("*.backlog.md")
+    )
+    assert len(created_files) == 1
+    text_empty = created_files[0].read_text(encoding="utf-8")
+    assert text_empty.count(pointer) == 1
+
+    # 3. Apply when body already includes pointer does not duplicate it
+    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+        rc = backlog.run_new(
+            _new_backlog_args(
+                repo,
+                summary="Pre-existing pointer body check",
+                body=f"{pointer}\n\nDetails follow.\n",
+                apply=True,
+            )
+        )
+    assert rc == 0
+    all_open = sorted(
+        (repo / ".aw" / "records" / "backlog" / "open").glob("*.backlog.md")
+    )
+    assert len(all_open) == 2
+    second = [p for p in all_open if p != created_files[0]][0]
+    text_second = second.read_text(encoding="utf-8")
+    assert text_second.count(pointer) == 1
+    assert "Details follow." in text_second
+
+    # 4. Pointer survives aw backlog set transition
+    id6 = meta.read_mirror_id6(text_second)
+    assert id6 is not None
+    set_args = argparse.Namespace(
+        dir=str(repo),
+        status="blocked",
+        args=[id6],
+        path=None,
+        actor="test",
+        message="waiting on decision D1",
+        gate_kind="decision",
+        gate_ref="D1",
+        gate_summary=None,
+        priority=None,
+        work_kind=None,
+        kind=None,
+        blocks_release=None,
+        release_exempt_kind=None,
+        release_exempt_ref=None,
+        close_evidence=None,
+        from_backlog=None,
+        from_spec=None,
+        graduated_to=None,
+        gate_dir=None,
+        gate_root=None,
+        lane_carrier_ref=None,
+        lane_carrier_path=None,
+        by_human=False,
+        apply=True,
+        agent=False,
+        json=False,
+    )
+    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+        rc_set = backlog.run_set(set_args)
+    assert rc_set == 0
+    moved = repo / ".aw" / "records" / "backlog" / "blocked" / second.name
+    assert moved.is_file()
+    moved_text = moved.read_text(encoding="utf-8")
+    assert moved_text.count(pointer) == 1
+    assert "status: blocked" in moved_text
+    assert backlog.validate_item(moved, moved_text) == []
+
