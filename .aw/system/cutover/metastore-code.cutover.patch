+    )
+    log_path = rec_root / "meta" / "frz001.jsonl"
+    valid_log_bytes = log_path.read_bytes()
+    rel_file = item_path.relative_to(repo).as_posix()
+    queue = [
+        {
+            "id6": "frz001",
+            "artifact_type": "backlog",
+            "status": "open",
