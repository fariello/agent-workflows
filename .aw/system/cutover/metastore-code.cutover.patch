+    log_path.write_bytes(valid_log_bytes)
+    runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
+
+    # 4. Modify meta/<id6>.jsonl to corrupt JSON without touching .backlog.md -> cache invalidates -> refuses
+    log_path.write_text("{corrupt\n", encoding="utf-8")
+    with pytest.raises(runner_shared.DriverError) as exc_corrupt:
+        runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
