+
+    # Log-field placeholders checked when state is passed.
+    base_fields = {
+        "plan_role": "child",
+        "author": "tester/model",
+        "highest_e_allocated": "01",
+        "scope_paths": "agent_workflows/example.py",
+        "item_dependencies": "none",
+        "priority": "high",
+        "work_kind": "bug",
+    }
+    resolved_state = _meta.State(
+        id6="plh001", type="ipd", status="draft", fields=dict(base_fields)
+    )
+    assert _auth.authoring_placeholders_resolved(clean_body, state=resolved_state) is True
+
+    for key, bad_val in (
+        ("scope_paths", "TODO (comma-separated repo-relative paths or pathspecs)"),
+        ("scope_paths", ["TODO: list paths"]),
+        ("item_dependencies", "unresolved"),
+        ("priority", "unresolved"),
+        ("work_kind", "unresolved"),
+    ):
+        fields = dict(base_fields)
+        fields[key] = bad_val
+        st = _meta.State(id6="plh001", type="ipd", status="draft", fields=fields)
+        assert _auth.authoring_placeholders_resolved(clean_body, state=st) is False
+
+    # Empty list item_dependencies with dependency_declaration="unresolved" is unresolved.
+    st_decl_unres = _meta.State(
+        id6="plh001",
+        type="ipd",
+        status="draft",
+        fields={
+            **base_fields,
+            "item_dependencies": [],
+            "dependency_declaration": "unresolved",
+        },
+    )
+    assert _auth.authoring_placeholders_resolved(clean_body, state=st_decl_unres) is False
+
+    # End-to-end check: ipd_lint._draft_ready_advisory and check_engine.check_ipd_draft_ready
+    # stay silent while scope_paths is a TODO placeholder and nudge once resolved.
+    repo = _init_temp_repo(tmp_path)
+    id6 = "drf001"
+    plan_path = _create_log_plan(
+        repo,
+        id6=id6,
+        rel_dest=f"plans/pending/20261125-demo-01-{id6}-draft-ready.ipd.md",
+        fields={
+            "status": "draft",
+            "plan_role": "child",
+            "set": "demo",
+            "order": 1,
+            "work_kind": "bug",
+            "priority": "high",
+            "scope_paths": "TODO (comma-separated repo-relative paths or pathspecs)",
+            "item_dependencies": "none",
+            "author": "tester/model",
+            "highest_e_allocated": "01",
+        },
+        body=clean_body,
+    )
+    res_stub = _lint.lint_file(plan_path, checkpoint="author")
+    assert not any(a.code == _lint.C_DRAFT_READY for a in res_stub.advisories)
+    assert _ce.check_ipd_draft_ready(repo, include_untracked=True) == []
+
+    ctx = _meta.legacy_context(repo)
+    _meta.append(
+        id6,
+        [{"op": "set", "fields": {"scope_paths": ["agent_workflows/example.py"]}}],
+        project_context=ctx,
+        actor={"tool": "aw set"},
+    )
+    res_ready = _lint.lint_file(plan_path, checkpoint="author")
+    assert any(a.code == _lint.C_DRAFT_READY for a in res_ready.advisories)
+    drifts = _ce.check_ipd_draft_ready(repo, include_untracked=True)
+    assert len(drifts) == 1
+    assert drifts[0].rule == "check.ipd-draft-ready-to-review"
