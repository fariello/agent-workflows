+
+    # 1. Valid log present -> passes
+    runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
+
+    # 2. Delete meta/<id6>.jsonl without touching .backlog.md -> cache invalidates -> refuses
+    log_path.unlink()
+    with pytest.raises(runner_shared.DriverError) as exc_deleted:
+        runner_shared.enforce_freeze_time_refusal(queue, repo=repo, color=False)
