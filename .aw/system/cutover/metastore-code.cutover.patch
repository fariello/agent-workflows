+    assert closed_dest == agents_rec / "backlog" / "done" / agents_blocked.name
+    assert closed_dest.is_file()
+    assert not agents_blocked.exists()
+    closed_text = closed_dest.read_text(encoding="utf-8")
+    assert backlog.validate_item(closed_dest, closed_text, repo_root=repo) == []
+    closed_state = meta.read("mix003", project_context=agents_ctx)
+    assert closed_state.status == "done"
+    assert not closed_state.fields.get("gate_kind")
