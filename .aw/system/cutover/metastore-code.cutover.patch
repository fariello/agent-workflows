+            "status": "open",
+            "title": "Release Blocker",
+            "priority": "high",
+            "work_kind": "bug",
+            "blocks_release": "next",
+        },
+        "# Backlog: Release Blocker\n",
+        destination="backlog/open/20261126-bk0020-01-bk0020-blocker.backlog.md",
+        project_context=ctx,
+    )
+    _git_commit_all(s2_repo, "schema-2 baseline")
+
+    # Stage raw violations (plan mirror flipped to executed; backlog moved/closed without gate)
