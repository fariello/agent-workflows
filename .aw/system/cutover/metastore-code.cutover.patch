+def test_run_scaffold_apply_lint_and_sync_apply(tmp_path: Path) -> None:
+    repo = _init_temp_repo(tmp_path)
+    args = argparse.Namespace(
+        dir=str(repo),
+        kind="child",
+        title="Log format scaffold test",
+        set="demo",
+        order=1,
+        author="tester/model",
+        priority="high",
+        work_kind="bug",
+        from_backlog=None,
+        summary="Test scaffold and sync on log format",
+        path=None,
+        legacy_name=False,
+        overwrite=False,
+        apply=True,
+        agent=False,
+        json=False,
+    )
+    rc = _auth.run_scaffold(args)
+    assert rc == 0
+
+    pending_files = list((repo / ".aw" / "records" / "plans" / "pending").glob("*.ipd.md"))
+    assert len(pending_files) == 1
+    plan_path = pending_files[0]
+    written_text = plan_path.read_text(encoding="utf-8")
+
+    # Verify post-cutover shape: YAML mirror, aw-managed banner, H1, writing pointer, ## Goal.
+    lines = written_text.splitlines()
+    assert lines[0] == "---"
+    assert lines[1].startswith("id: ")
+    plan_id = lines[1].split(": ", 1)[1].strip()
+    assert lines[2] == "status: draft"
+    assert lines[3] == "---"
+    assert lines[4].startswith("<!-- aw-managed: metadata lives in .aw/records/meta/")
+    assert lines[5] == "# IPD: Log format scaffold test"
+    assert "- Date:" not in written_text
+    assert "## Workflow history" not in written_text
+    assert "## Goal" in written_text
+
+    log_path = repo / ".aw" / "records" / "meta" / f"{plan_id}.jsonl"
+    assert log_path.is_file()
+
+    # Freshly scaffolded plan lints conforming at author checkpoint.
+    lint_res = _lint.lint_file(plan_path, checkpoint="author")
+    assert lint_res.disposition == _schema.DISPOSITION_CONFORMING, lint_res.diagnostics
+
+    # Add an E-NEW leaf and run sync --apply; verify E-02/V-02 and highest_e_allocated bump.
+    with_new_leaf = written_text.replace(
+        "  - Execution state: pending\n",
+        "  - Execution state: pending\n\n"
+        "- [ ] E-NEW Second observable step.\n"
+        "  - Depends on: E-01\n"
+        "  - Expected outcome: second step succeeds.\n"
+        "  - Execution state: pending\n",
+        1,
+    )
+    plan_path.write_text(with_new_leaf, encoding="utf-8")
+
+    sync_args = argparse.Namespace(
+        path=[str(plan_path)],
+        all=False,
+        dir=str(repo),
+        apply=True,
+        agent=False,
+        json=False,
+    )
+    sync_rc = _auth.run_sync(sync_args)
+    assert sync_rc == 0
+
+    synced_text = plan_path.read_text(encoding="utf-8")
+    assert "- [ ] E-02 Second observable step." in synced_text
+    assert "- [ ] V-02 validates E-02" in synced_text
+
+    ctx = _meta.legacy_context(repo)
+    st_after = _meta.read(plan_id, project_context=ctx)
+    assert st_after.fields.get("highest_e_allocated") == "02"
+    log_events = [json.loads(ln) for ln in log_path.read_text(encoding="utf-8").splitlines() if ln.strip()]
+    assert any(
+        ev.get("op") == "set" and (ev.get("fields") or {}).get("highest_e_allocated") == "02"
+        for ev in log_events
+    )
+
+    # Synced plan still lints conforming at author.
+    lint_after_sync = _lint.lint_file(plan_path, checkpoint="author")
+    assert (
+        lint_after_sync.disposition == _schema.DISPOSITION_CONFORMING
+    ), lint_after_sync.diagnostics
+
+    # Transition to approved in the log and verify sync refuses on approved log-format plan.
+    _meta.append(
+        plan_id,
+        [{"op": "transition", "from": "draft", "to": "to-review"}],
+        project_context=ctx,
+        actor={"tool": "test"},
+    )
+    _meta.append(
+        plan_id,
+        [
+            {
+                "op": "review",
+                "review_kind": "gate",
+                "verdict": "APPROVE",
+                "readiness": "go-pending-approval",
+                "review_depth": "standard",
+                "round": 1,
+                "review_ref": f"reviews/20261125-demo-01-{plan_id}-sample.review.md",
+            },
+            {"op": "transition", "from": "to-review", "to": "reviewed"},
+        ],
+        project_context=ctx,
+        actor={"tool": "plan-review", "model": "test-model"},
+    )
+    _meta.append(
+        plan_id,
+        [
+            {"op": "transition", "from": "reviewed", "to": "approved"},
+            {"op": "set", "fields": {"approval": "2026-11-25, approved"}},
+        ],
+        project_context=ctx,
+        actor={"tool": "aw set"},
+        by_human=True,
+    )
+    refused_rc = _auth.run_sync(sync_args)
+    assert refused_rc == 1
+
