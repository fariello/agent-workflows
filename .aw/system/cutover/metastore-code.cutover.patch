+    rc_after = pr.recheck_conditions(repo, p_stale)
+    assert not rc_after.may_write
+    assert rc_after.readiness == "go-pending-approval"
+    assert all(not c.holds for c in rc_after.conditions)
+
+    # 7. Uncommitted append on apply=True raises RuntimeError
+    p_fail = _create_log_plan(
