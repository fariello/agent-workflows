+    assert (
+        review_sequence.count_verdict_bearing_entries(
+            plan_text_before, history=hist_before
+        )
+        == 0
+    )
+
+    # Append a recheck-readiness event (must NOT count as verdict-bearing) + one real gate review + transition to reviewed
+    meta.append(
+        "rv1001",
+        [
+            {
+                "op": "review",
+                "round": 1,
+                "review_kind": "gate",
+                "verdict": "APPROVE",
