+    # Every banner-preceded H1 and log-stored metadata token matches in default mode AND --full mode
+    for token in (
+        "PlanBannerH1Tok",
+        "PlanMetaTitleTok",
+        "PlanMetaDescTok",
+        "SpecBannerH1Tok",
+        "SpecMetaTitleTok",
+        "SpecMetaDescTok",
+        "BacklogBannerH1Tok",
+        "BacklogMetaSummaryTok",
+        "ResearchBannerH1Tok",
+        "ResearchMetaTitleTok",
+        "ResearchMetaSummaryTok",
+        "PromptBannerH1Tok",
+        "PromptMetaTitleTok",
+        "PromptMetaSummaryTok",
+    ):
+        rc_def, data_def = _search_json(repo, token, full=False)
+        assert rc_def == 0, f"default search missed {token}"
+        assert data_def["data"]["hits"] >= 1
+        rc_full, data_full = _search_json(repo, token, full=True)
+        assert rc_full == 0, f"--full search missed {token}"
+        assert set(data_def["data"]["files"]).issubset(set(data_full["data"]["files"]))
+
+    # Body-only tokens are excluded in default mode and matched in --full mode
+    for body_tok in (
+        "PlanBodyOnlyTok",
+        "SpecBodyOnlyTok",
+        "BacklogBodyOnlyTok",
+        "ResearchBodyOnlyTok",
+        "PromptBodyOnlyTok",
+    ):
+        rc_def, data_def = _search_json(repo, body_tok, full=False)
+        assert rc_def == 1, f"default search unexpectedly matched body token {body_tok}"
+        assert data_def["data"]["hits"] == 0
+        rc_full, data_full = _search_json(repo, body_tok, full=True)
+        assert rc_full == 0, f"--full search missed body token {body_tok}"
+        assert data_full["data"]["hits"] == 1
