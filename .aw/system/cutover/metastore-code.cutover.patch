+"""Core behavioral tests for CLI creator log fields and bare-repo context alignment (IPD 6cltab)."""
+
+from __future__ import annotations
+
+import io
+import json
+import subprocess
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+
+import pytest
+
+from agent_workflows import artifact_meta as meta
+from agent_workflows import check_engine, cli, selectors, status_set
+from agent_workflows import project_context as proj_ctx
+from tests import repo_template
+from tests.record_builder import RecordBuilder
+
+pytestmark = pytest.mark.core
+
+
+def _bare_records_repo(base: Path) -> Path:
+    """Create a bare temporary git repository with `.aw/records/` and no `.aw/config/`."""
+    repo = repo_template.copy_template_repo(base)
+    for sub in (
+        "plans/pending",
+        "specs/draft",
+        "backlog/open",
+        "backlog/done",
+        "research",
+        "releases",
+        "prompts/pending",
+        "walkthroughs",
+        "reviews",
+    ):
+        (repo / ".aw" / "records" / sub).mkdir(parents=True, exist_ok=True)
+    return repo
+
+
+def _run_cli_in_repo(
+    repo: Path, argv: list[str], monkeypatch: pytest.MonkeyPatch
+) -> tuple[int, str, str]:
+    monkeypatch.chdir(repo)
+    out, err = io.StringIO(), io.StringIO()
+    with redirect_stdout(out), redirect_stderr(err):
+        try:
+            rc = cli.main(argv)
+        except SystemExit as exc:
+            rc = int(exc.code or 0)
+    return rc, out.getvalue(), err.getvalue()
+
+
+def _single_state(repo: Path, record_type: str, *, ctx=None) -> meta.State:
+    eff_ctx = ctx if ctx is not None else meta.legacy_context(repo)
+    rows = meta.query(type=record_type, project_context=eff_ctx).rows
+    assert len(rows) == 1, f"expected 1 {record_type} row, got {rows}"
+    return meta.read(rows[0].id6, project_context=eff_ctx)
