+def _patch_log_with_raw_fields(
+    log_path: Path,
+    raw_fields: dict[str, Any],
+    *,
+    record_type: str,
+) -> None:
+    """Patch event 1 in ``meta/<id6>.jsonl`` with ``raw_fields`` overrides for disk fixtures."""
+    if not log_path.is_file():
+        return
+    raw_lines = log_path.read_text(encoding="utf-8").splitlines(keepends=True)
+    if not raw_lines:
+        return
+    ev0 = _meta.decode_line(raw_lines[0])
+    fields = dict(ev0.get("fields") or {})
+    changed = False
+    for raw_key, raw_val in raw_fields.items():
+        dest_kind, target = _normalize_raw_key(record_type, raw_key)
+        if record_type == "ipd" and dest_kind == "body_section" and target in (
+            "Concern",
+            "Scope",
+        ):
+            continue
+        if raw_val is None:
+            if target in fields:
+                fields.pop(target, None)
+                changed = True
+        else:
+            fields[target] = raw_val
+            changed = True
+    if not changed:
+        return
+    ev0["fields"] = fields
+    raw_lines[0] = _meta.encode_event(ev0)
+    _core.atomic_write(log_path, "".join(raw_lines))
