+def _orchestrator_body(child_rows: List[Tuple[int, str, str]]) -> str:
+    table_lines = [
+        "| Order | Id | Child | Depends on |",
+        "|---|---|---|---|",
+    ]
+    e_blocks = []
+    v_blocks = []
+    for idx, (order_n, cid, desc) in enumerate(child_rows, start=1):
+        table_lines.append(f"| {order_n:02d} | `{cid}` | {desc} | none |")
+        e_blocks.append(
+            f"- [ ] E-{idx:02d} CONFIRM {cid} REACHED executed\n"
+            "  - Depends on: none\n"
+            f"  - Expected outcome: child `{cid}` executed.\n"
+            "  - Execution state: pending\n"
+        )
+        v_blocks.append(
+            f"- [ ] V-{idx:02d} validates E-{idx:02d}\n"
+            f"  - Required evidence: child `{cid}` executed.\n"
+            "  - Observed evidence:\n"
+            "  - Result: pending\n"
+        )
+    return (
+        "# IPD: Demo set orchestrator\n\n"
+        "## Concern\n\nCoordinate child plans.\n\n"
+        "## Scope\n\nOrchestration only.\n\n"
+        "## Goal\n\nCoordinate children.\n\n"
+        "## Child IPDs, sequence, and dependencies\n\n"
+        + "\n".join(table_lines)
+        + "\n\n"
+        "## Detailed Implementation Checklist (TODO)\n\n"
+        "### Task group 1: coordinate\n\n"
+        + "\n".join(e_blocks)
+        + "\n"
+        "## Project conventions discovered (Step 0)\n\n- None.\n\n"
+        "## Findings\n\n- None.\n\n"
+        "## Proposed changes (ordered, validatable)\n\n1. Run children.\n\n"
+        "## Deferred / out of scope (with reason)\n\n- None.\n\n"
+        "## Scope check\n\n- Over-scope: none.\n- Under-scope: none.\n\n"
+        "## Required tests / validation\n\n- `python3 -m pytest`\n\n"
+        "## Spec / documentation sync\n\n- None.\n\n"
+        "## Open questions\n\nNone open.\n\n"
+        "## Validation and cross-check (verify before reporting done)\n\n"
+        + "\n".join(v_blocks)
+        + "\n"
+        "## Approval and execution gate\n\n"
+        "- Size assessment: standard\n"
+        "- Cohesion rationale: not required\n"
+    )
