+def _format_log_history(events: List[Dict[str, Any]]) -> Tuple[str, ...]:
+    """Render ordered ``artifact_meta`` log events into human-readable history lines."""
+    lines: List[str] = []
+    for ev in events:
+        if not isinstance(ev, dict):
+            continue
+        day = str(ev.get("at") or "")[:10]
+        op = str(ev.get("op") or "").strip()
+        if op == "transition":
+            label = str(ev.get("to") or op)
+        elif op == "create":
+            ev_fields = ev.get("fields") or {}
+            label = str(
+                ev_fields.get("status") if isinstance(ev_fields, dict) else "created"
+            ) or "created"
+        else:
+            label = op or "event"
+        actor_obj = ev.get("actor")
+        actor = ""
+        if isinstance(actor_obj, dict):
+            actor = str(actor_obj.get("tool") or actor_obj.get("id") or "").strip()
+        if not actor:
+            actor = str(ev.get("actor_id") or "").strip()
+        msg = str(ev.get("message") or "").strip()
+        head = f"{day} {label}".strip() if day else label
+        if actor:
+            head = f"{head} ({actor})"
+        if msg:
+            head = f"{head}: {msg}"
+        if head:
+            lines.append(head)
+    return tuple(lines)
+
