+    assert skips_with_rcpt == [(p_inflight, "live begin receipt present")]
+
+    dummy_edits = [
+        refs.RefEdit(p_ready, refs.FULL_NAME, "old.md", "new.md", 1),
+        refs.RefEdit(p_inflight, refs.FULL_NAME, "old.md", "new.md", 1),
