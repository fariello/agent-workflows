+            "backlog/open/20261125-srchbk-01-bk3001-b.backlog.md",
+        ),
+        (
+            "rs3001",
+            "research",
+            {
+                "status": "reference",
+                "title": "ResearchMetaTitleTok",
+                "short_description": "ResearchMetaSummaryTok",
+            },
+            "# Research: ResearchBannerH1Tok\n\n## Findings\n\nResearchBodyOnlyTok\n",
+            "research/20261125-rs3001-01-rs3001-r.research.md",
+        ),
+        (
+            "pr3001",
+            "prompt",
+            {
+                "status": "pending",
+                "title": "PromptMetaTitleTok",
+                "short_description": "PromptMetaSummaryTok",
+            },
+            "# Prompt: PromptBannerH1Tok\n\n## Instructions\n\nPromptBodyOnlyTok\n",
+            "prompts/pending/20261125-pr3001-01-pr3001-pr.prompt.md",
+        ),
+    ]
+    for id6, atype, fields, body, dest in fixtures:
+        meta.create(id6, atype, fields, body, destination=dest, project_context=ctx)
