+def test_run_review_sequence_threads_log_state_end_to_end(tmp_path: Path) -> None:
+    """runner_shared.run_review_sequence threads companion log state/history through tier_facts, structural_diff, S5, MD-15 guard, and S7."""
+    repo = _init_log_repo(tmp_path, with_git=True)
+    p_path = _create_log_plan(
+        repo,
+        "sq1001",
+        status="to-review",
+        plan_role="child",
+        scope_paths=["agent_workflows/demo.py", ".aw/records/specs/approved/20261126-sp1001-01-sp1001-demo.spec.md"],
+    )
+    _git(repo, "add", ".aw")
+    _git(repo, "commit", "-m", "add log plan sq1001")
+
+    rev_path = repo / ".aw" / "records" / "reviews" / "20261126-demo-01-sq1001-sample-plan.review.md"
+    run_dir = repo / ".aw" / "state" / "runs" / "test-run"
+    (run_dir / "sessions").mkdir(parents=True, exist_ok=True)
+    (run_dir / "prompts").mkdir(parents=True, exist_ok=True)
+
+    rel_plan = p_path.relative_to(repo).as_posix()
+    item: dict[str, Any] = {
+        "position": 1,
+        "id6": "sq1001",
+        "setid": "demo",
+        "action": "review",
+        "configured_file": rel_plan,
+        "status": "running",
+        "attempts": [],
+    }
+    attempt: dict[str, Any] = {"attempt": 1}
+    item["attempts"].append(attempt)
+    state: dict[str, Any] = {"options": {"review_variant": "single-12", "quick_ok": True}}
+    ctx = meta.legacy_context(repo)
+
+    def _write_oc_log(log_file: Path, reply_text: str) -> None:
+        log_file.parent.mkdir(parents=True, exist_ok=True)
+        log_file.write_text(
+            json.dumps({"type": "text", "part": {"text": reply_text}}) + "\n",
+            encoding="utf-8",
+        )
+
+    def _spawn(prompt_p, work_dir, tracker, plan_p, att_no, sess_id, use_cont):
+        # Prompt 1: P + T -> write spec-4.1a YAML review mirror with Proofreading + Step T
+        prompt_text = Path(prompt_p).read_text(encoding="utf-8")
+        assert "- Kind: child" in prompt_text
+        assert "- Names spec: yes" in prompt_text
+        rev_path.write_text(
+            "---\n"
+            "subject: sq1001\n"
+            "subject_type: ipd\n"
+            "---\n"
+            "# Review: sq1001\n\n"
+            "## Round 1\n\n"
+            "### Proofreading\n\nChecked.\n\n"
+            "### Step T\n\n"
+            "1. Simple change.\n"
+            "2. Low risk.\n"
+            "3. Small scope.\n"
+            "4. Clear tests.\n"
+            "5. Tier is simple.\n\n"
+            "### Step Q\n\n"
+            "- Checked: quick risk pass.\n",
+            encoding="utf-8",
+        )
+        lp = run_dir / "sessions" / "01-sq1001-p1.jsonl"
+        _write_oc_log(lp, "Proofread and tiered.\nAW-TIER: simple")
+        return 0, "sess-1", lp, ["oc"]
+
+    def _launcher(st, rdir, itm, plan_p, prompt_p, att_no, **kwargs):
+        suffix = kwargs.get("log_suffix", "step")
+        prompt_text = Path(prompt_p).read_text(encoding="utf-8")
+        lp = run_dir / "sessions" / f"01-sq1001-{suffix}.jsonl"
+        if "s7-finalize.md" in prompt_text:
+            # S7 appends gate review + transition to reviewed in the companion log
+            meta.append(
+                "sq1001",
+                [
+                    {
+                        "op": "review",
+                        "round": 1,
+                        "review_kind": "gate",
+                        "verdict": "APPROVE",
+                        "readiness": "go-pending-approval",
+                        "message": "APPROVE",
+                    },
+                    {
+                        "op": "transition",
+                        "from": "to-review",
+                        "to": "reviewed",
+                    },
+                ],
+                actor={"tool": "plan-review", "model": "m1"},
+                project_context=ctx,
+            )
+            _write_oc_log(lp, "Finalized review.")
+        elif "s6-rereview.md" in prompt_text or "s5-questions.md" in prompt_text:
+            _write_oc_log(lp, "Questions checked.\nAW-REVIEW: DONE")
+        else:
+            rev_path.write_text(
+                rev_path.read_text(encoding="utf-8")
+                + "\n### Step Q\n\n- Checked: quick risk.\n",
+                encoding="utf-8",
+            )
+            _write_oc_log(lp, "Step complete.")
+        return 0, "sess-1", lp, ["oc"]
+
+    rc, sid, _lp, _argv = runner_shared.run_review_sequence(
+        run_dir / "prompts" / "init.md",
+        str(repo),
+        None,
+        p_path,
+        1,
+        None,
+        False,
+        state=state,
+        item=item,
+        run_dir=run_dir,
+        repo=repo,
+        host_labels=runner_shared.OC_HOST_LABELS,
+        spawn_executor=_spawn,
+        raw_launcher=_launcher,
+        save_state=lambda _rd, _st: None,
+        append_jsonl=lambda *a, **kw: None,
+        pal=runner_shared.Palette(False),
+        attempt=attempt,
+    )
+    assert rc == 0
+    assert sid == "sess-1"
+    assert attempt["review_tier"] == "simple"
+    assert attempt["review_tier_facts"]["names_spec"] is True
