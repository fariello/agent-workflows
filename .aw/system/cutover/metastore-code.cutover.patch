+def _create_log_plan(
+    repo: Path,
+    id6: str,
+    *,
+    status: str = "to-review",
+    bucket: str = "pending",
+    slug: str = "sample-plan",
+    set_id: str = "demo",
+    order: int = 1,
+    plan_role: str = "child",
+    scope_paths: list[str] | None = None,
+    item_dependencies: list[dict[str, Any]] | None = None,
+    extra_fields: dict[str, Any] | None = None,
+    body: str | None = None,
+    extra_events: list[dict[str, Any]] | None = None,
+) -> Path:
+    rel = f"plans/{bucket}/20261126-{set_id}-{order:02d}-{id6}-{slug}.ipd.md"
+    plan_path = repo / ".aw" / "records" / rel
+    plan_path.parent.mkdir(parents=True, exist_ok=True)
+    mirror = meta.render_in_file_mirror(id6, "ipd", status)
+    plan_path.write_text(
+        mirror + (body if body is not None else _conforming_child_body(slug)),
+        encoding="utf-8",
+    )
+    fields: dict[str, Any] = {
+        "type": "ipd",
+        "status": status,
+        "plan_role": plan_role,
+        "set": set_id,
+        "order": order,
+        "priority": "medium",
+        "work_kind": "bug",
+        "highest_e_allocated": "01",
+        "author": "test-agent",
+        "scope_paths": (
+            scope_paths if scope_paths is not None else [f".aw/records/{rel}"]
+        ),
+    }
+    if item_dependencies is not None:
+        fields["item_dependencies"] = item_dependencies
+    else:
+        fields["dependency_declaration"] = "none"
+    if extra_fields:
+        fields.update(extra_fields)
+    events: list[dict[str, Any]] = [
+        {
+            "seq": 0,
+            "append": 0,
+            "op": "checkpoint",
+            "at": "2026-11-26T10:00:00Z",
+            "actor": {"tool": "test"},
+            "path": rel,
+            "fields": fields,
+            "message": "created",
+        }
+    ]
+    if extra_events:
+        events.extend(extra_events)
+    _write_log(repo, id6, events)
+    return plan_path
+
