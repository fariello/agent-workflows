+def test_artifact_rename_to_id6_rolls_back_git_mv_on_create_failure(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    repo = _init_log_repo(tmp_path, git=True)
+    specs_dir = repo / ".aw" / "records" / "specs"
+    legacy_spec = specs_dir / "20260701-1200-01-rollback-spec.spec.md"
+    orig_text = (
+        "# Spec: Rollback\n\n- Date: 2026-07-01\n- Status: draft\n\n## Overview\n\nKeep me.\n"
+    )
+    legacy_spec.write_text(orig_text, encoding="utf-8")
+    _git_commit_all(repo)
+
+    # Case 1: artifact_meta.create raises an exception -> git_mv is rolled back, exit 2
+    def _raise_create(*_args, **_kwargs):
+        raise ValueError("simulated log refusal")
+
+    monkeypatch.setattr(meta, "create", _raise_create)
+    res_exc = artifact_rename.run_rename_generic(
+        argparse.Namespace(
+            dir=str(repo),
+            id=legacy_spec.name,
+            to_id6=True,
+            apply=True,
+            no_refs=True,
+            yes=True,
+            emit_human=False,
+        ),
+        "specs",
+    )
+    assert res_exc.rc == 2
+    assert res_exc.diagnostics[0].rule == "meta-validation-error"
+    assert legacy_spec.is_file()
+    assert legacy_spec.read_text(encoding="utf-8") == orig_text
+    assert list(specs_dir.glob("*.spec.md")) == [legacy_spec]
+
+    # Case 2: artifact_meta.create returns committed=False -> git_mv is rolled back, exit 2
+    monkeypatch.setattr(
+        meta, "create", lambda *_a, **_kw: {"committed": False, "error": "busy"}
+    )
+    res_uncommitted = artifact_rename.run_rename_generic(
+        argparse.Namespace(
+            dir=str(repo),
+            id=legacy_spec.name,
+            to_id6=True,
+            apply=True,
+            no_refs=True,
+            yes=True,
+            emit_human=False,
+        ),
+        "specs",
+    )
+    assert res_uncommitted.rc == 2
+    assert res_uncommitted.diagnostics[0].rule == "meta-validation-error"
+    assert legacy_spec.is_file()
+    assert list(specs_dir.glob("*.spec.md")) == [legacy_spec]
