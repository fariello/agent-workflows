+
+def _create_log_plan(
+    repo: Path,
+    *,
+    id6: str,
+    rel_dest: str,
+    fields: Dict[str, Any],
+    body: str,
+) -> Path:
+    ctx = _meta.legacy_context(repo)
+    _meta.create(
+        id6,
+        "ipd",
+        fields,
+        body,
+        destination=rel_dest,
+        project_context=ctx,
+        actor={"tool": "test"},
+        message="created.",
+    )
+    return repo / ".aw" / "records" / rel_dest
+
+
+# --------------------------------------------------------------------------------------
+# 1. ipd_schema: H2 orders vs patched templates + log_format validate_metadata
+# --------------------------------------------------------------------------------------
+
+
+def test_schema_h2_orders_match_patched_templates() -> None:
+    child_template = (TEMPLATES_DIR / "ipd.md").read_text(encoding="utf-8")
+    orch_template = (TEMPLATES_DIR / "orchestrator-ipd.md").read_text(encoding="utf-8")
+
+    child_titles = tuple(h.title for h in _lint.parse(child_template).h2)
+    orch_titles = tuple(h.title for h in _lint.parse(orch_template).h2)
+
+    assert _schema.H_WORKFLOW_HISTORY not in _schema.CHILD_H2_ORDER
+    assert _schema.H_WORKFLOW_HISTORY not in _schema.ORCHESTRATOR_H2_ORDER
+    assert _schema.CHILD_H2_ORDER[0] == _schema.H_GOAL
+    assert _schema.ORCHESTRATOR_H2_ORDER[0] == _schema.H_GOAL
+    assert child_titles == _schema.CHILD_H2_ORDER
+    assert orch_titles == _schema.ORCHESTRATOR_H2_ORDER
+
+
+def test_schema_validate_metadata_log_format_vs_legacy() -> None:
+    log_fields = {
+        "Date": "2026-11-25",
+        "Kind": "child",
+        "Status": "draft",
+        "Author": "tester/model",
+        "Id": "abc123",
+    }
+    assert _schema.validate_metadata(log_fields, directory="pending", log_format=True) == []
+
+    # Legacy default keeps Concern and Scope required in META_REQUIRED.
+    legacy_errs = _schema.validate_metadata(log_fields, directory="pending")
+    missing_fields = {e.field for e in legacy_errs if "missing" in e.message}
+    assert missing_fields == {"Concern", "Scope"}
+    assert "Concern" in _schema.META_REQUIRED
+    assert "Scope" in _schema.META_REQUIRED
+    assert _schema.META_REQUIRED_LOG == ("Date", "Kind", "Status", "Author", "Id")
+
+    # Missing a log-format required field is still rejected when log_format=True.
+    incomplete = dict(log_fields)
+    del incomplete["Author"]
+    errs = _schema.validate_metadata(incomplete, directory="pending", log_format=True)
+    assert any(e.field == "Author" and "missing" in e.message for e in errs)
+
