+    assert executed_transition_gate.check(s2_repo)[0] == 1
+    assert backlog_blocking_close_gate.check(s2_repo)[0] == 1
+
+    # 3. Wrong migration_id -> refused
+    s2_tree = _git_write_tree(s2_repo)
+    s2_marker.write_text(
+        json.dumps({"migration_id": "m9999", "tree_id": s2_tree}) + "\n",
+        encoding="utf-8",
+    )
+    assert executed_transition_gate.check(s2_repo)[0] == 1
+    assert backlog_blocking_close_gate.check(s2_repo)[0] == 1
+
+    # 4. Corrupt JSON marker -> refused
+    s2_marker.write_text("{corrupt json", encoding="utf-8")
+    assert executed_transition_gate.check(s2_repo)[0] == 1
+    assert backlog_blocking_close_gate.check(s2_repo)[0] == 1
