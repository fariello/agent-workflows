+    mirror = "---\nid: dt0001\nstatus: draft\n---\n" + body
+
+    # 1. created_day takes precedence over fields["date"], filename_date, path, created_at
+    st_cd = _meta.State(
+        id6="dt0001",
+        type="ipd",
+        status="draft",
+        path="plans/pending/20261120-demo-01-dt0001-x.ipd.md",
+        created_day="2026-10-01",
+        filename_date="20261115",
+        created_at="2026-11-25T12:00:00Z",
+        set_id="demo",
+        order_nn=1,
+        fields={
+            "date": "2026-10-05",
+            "plan_role": "child",
+            "author": "tester/model",
+            "highest_e_allocated": "01",
+        },
+    )
+    assert _lint.parse(mirror, state=st_cd).meta_fields["Date"] == "2026-10-01"
+
+    # 2. filename YYYYMMDD prefix from state.path when created_day/date/filename_date absent
+    st_path = _meta.State(
+        id6="dt0001",
+        type="ipd",
+        status="draft",
+        path="plans/pending/20261120-demo-01-dt0001-x.ipd.md",
+        created_at="2026-11-25T12:00:00Z",
+        set_id="demo",
+        order_nn=1,
+        fields={
+            "plan_role": "child",
+            "author": "tester/model",
+            "highest_e_allocated": "01",
+        },
+    )
+    assert _lint.parse(mirror, state=st_path).meta_fields["Date"] == "2026-11-20"
+    res_cit = _lint.lint_text(mirror, checkpoint="author", state=st_path)
+    assert res_cit.disposition == _schema.DISPOSITION_CONFORMING
+    assert any(a.code == _lint.C_CITATION_ANCHOR for a in res_cit.advisories)
+
+    # 3. created_at[:10] fallback when filename has no YYYYMMDD prefix
+    st_created = _meta.State(
+        id6="dt0001",
+        type="ipd",
+        status="draft",
+        path="plans/pending/custom-name.ipd.md",
