+    assert rc_ok == 0, f"batch to-review failed: {out_ok}\n{err_ok}"
+    payload = json.loads(out_ok)
+    change_paths = [c["path"] for c in payload["changes"] if c.get("applied")]
+    orch_idx = next(i for i, p in enumerate(change_paths) if "or2000" in p)
+    ch1_idx = next(i for i, p in enumerate(change_paths) if "ch2001" in p)
+    assert ch1_idx < orch_idx, change_paths
+
+    # Advance all three to reviewed with positive gate reviews, then batch-approve with orchestrator first
+    for pid in ("ch2001", "ch2002", "or2000"):
+        res_rev = meta.append(
+            pid,
+            [
+                {
+                    "op": "transition",
+                    "from": "to-review",
+                    "to": "reviewed",
+                    "message": "APPROVE",
+                },
+                {
+                    "op": "review",
+                    "review_kind": "gate",
+                    "round": 1,
+                    "verdict": "APPROVE",
+                    "readiness": "go-pending-approval",
+                    "message": "APPROVE",
+                },
+            ],
+            actor={"tool": "aw plan-review"},
+            project_context=ctx,
