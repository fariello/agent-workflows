+def test_hold_attended_plan_and_plan_kind_from_file_on_log_and_legacy(
+    tmp_path: Path,
+) -> None:
+    """hold_attended_plan holds headless / marks interactive on log attended='required' plans; plan_kind_from_file reads log plan_role."""
+    repo = _init_log_repo(tmp_path)
+    p_att = _create_log_plan(
