+    # Searching an id6 already present in the YAML mirror does not emit a duplicate line: 0 match
+    rc_id, data_id = _search_json(repo, "pl3001", full=False)
+    assert rc_id == 0
+    lines_for_pl = [
+        m["line"] for m in data_id["data"]["matches"] if "pl3001" in m["path"]
+    ]
+    assert 0 not in lines_for_pl
