+                "release.id-missing",
+                f"corrupt/invalid metadata log: {log_error}",
+            )
+        ]
+    if resolved_state is not None:
+        return validate_release_state(path, resolved_state, text=text)
+
+    rf = _read_release_fields(text)
+    return _validate_release_fields(loc, rf, text)
