+def test_coverage_record_write_read_is_current_and_dirty_log_refusal(
+    tmp_path: Path,
+) -> None:
+    """coverage_record commits companion log on pass/fail, derives date/model from op='coverage', and refuses dirty logs."""
+    repo = _init_log_repo(tmp_path, with_git=True)
+    _create_log_plan(repo, "ch1001", status="to-review", order=1, slug="child-one")
+    orch_path = _create_log_plan(
+        repo,
+        "or1001",
+        status="to-review",
+        order=0,
+        plan_role="orchestrator",
+        slug="orch-one",
+        body=_orchestrator_body("ch1001"),
+    )
+    _git(repo, "add", ".aw")
+    _git(repo, "commit", "-m", "initial log orchestrator")
+
+    # Pass write with commit=True commits .aw/records/meta/or1001.jsonl even though .ipd.md is unchanged
+    res_pass = coverage_record.write(
+        orch_path,
+        coverage_record.COVERAGE_PASS,
+        model="gpt-5-mini",
+        tool="aw oc run",
+        commit=True,
+        host="oc",
+        repo=repo,
+    )
+    assert res_pass.written is True
+    assert res_pass.committed is True
+    committed_files = _git(repo, "show", "--name-only", "--format=", "HEAD").splitlines()
+    assert ".aw/records/meta/or1001.jsonl" in committed_files
+
+    orch_text = orch_path.read_text(encoding="utf-8")
+    rec = coverage_record.read(orch_text, plan_path=orch_path, repo=repo)
+    assert rec.verdict == coverage_record.COVERAGE_PASS
+    assert rec.fingerprint == runner_shared.probe_cache_digest(orch_text)
+    assert len(rec.date) == 10 and rec.date[4] == "-"
+    assert rec.model == "gpt-5-mini"
+    assert coverage_record.is_current(orch_text, plan_path=orch_path, repo=repo) is True
+
+    # Fail write with commit=True commits BOTH the plan file (with ## Coverage findings) and companion log
+    res_fail = coverage_record.write(
+        orch_path,
+        coverage_record.COVERAGE_FAIL,
+        quotes=("Run full deployment script directly.",),
+        model="",
+        tool="aw agy run",
+        commit=True,
+        host="agy",
+        repo=repo,
+    )
+    assert res_fail.written is True
+    assert res_fail.committed is True
+    fail_files = _git(repo, "show", "--name-only", "--format=", "HEAD").splitlines()
+    assert ".aw/records/meta/or1001.jsonl" in fail_files
+    assert any(f.endswith("or1001-orch-one.ipd.md") for f in fail_files)
+
+    fail_text = orch_path.read_text(encoding="utf-8")
+    rec_fail = coverage_record.read(fail_text, plan_path=orch_path, repo=repo)
+    assert rec_fail.verdict == coverage_record.COVERAGE_FAIL
+    assert rec_fail.model == "by host-default"
+    assert rec_fail.quotes == ("Run full deployment script directly.",)
+    assert coverage_record.is_current(fail_text, plan_path=orch_path, repo=repo) is True
+
+    # Body edit invalidates fingerprint
+    edited_text = fail_text.replace(
+        "Coordinate child `ch1001`.", "Coordinate child `ch1001` and run extra release."
+    )
+    assert coverage_record.is_current(edited_text, plan_path=orch_path, repo=repo) is False
+
+    # commit=False writes without creating a commit
+    head_before = _git(repo, "rev-parse", "HEAD")
+    res_nocommit = coverage_record.write(
+        orch_path,
+        coverage_record.COVERAGE_PASS,
+        model="claude-opus",
+        tool="aw oc run",
+        commit=False,
+        repo=repo,
+    )
+    assert res_nocommit.written is True
+    assert res_nocommit.committed is False
+    assert _git(repo, "rev-parse", "HEAD") == head_before
+
+    # Now companion log is dirty -> commit=True refuses to commit but still writes
+    res_dirty = coverage_record.write(
+        orch_path,
+        coverage_record.COVERAGE_PASS,
+        model="claude-opus",
+        tool="aw oc run",
+        commit=True,
+        repo=repo,
+    )
+    assert res_dirty.written is True
+    assert res_dirty.committed is False
+    assert "uncommitted" in res_dirty.detail.lower()
+    assert _git(repo, "rev-parse", "HEAD") == head_before
+
+    # Migrated orchestrator carrying stale migration-only coverage_checked:
+    # before re-probe read() uses coverage_checked; after a new op='coverage' write,
+    # read() must prefer the newest op='coverage' event's date and model.
+    mig_orch = _create_log_plan(
+        repo,
+        "or1002",
+        status="to-review",
+        order=0,
+        set_id="migset",
+        plan_role="orchestrator",
+        slug="orch-migrated",
+        body=_orchestrator_body("ch1001"),
+        extra_fields={
+            "coverage": "pass",
+            "coverage_fingerprint": "0" * 64,
+            "coverage_checked": "2026-10-01 by legacy-migrated-model",
+        },
+    )
+    mig_text = mig_orch.read_text(encoding="utf-8")
+    rec_mig_before = coverage_record.read(mig_text, plan_path=mig_orch, repo=repo)
+    assert rec_mig_before.date == "2026-10-01"
+    assert rec_mig_before.model == "legacy-migrated-model"
+    res_mig_reprobe = coverage_record.write(
+        mig_orch,
+        coverage_record.COVERAGE_PASS,
+        model="fresh-reprobe-model",
+        tool="aw oc run",
+        commit=False,
+        repo=repo,
+    )
+    assert res_mig_reprobe.written is True
+    rec_mig_after = coverage_record.read(mig_text, plan_path=mig_orch, repo=repo)
+    assert rec_mig_after.model == "fresh-reprobe-model"
+    assert rec_mig_after.date != "2026-10-01"
+    assert len(rec_mig_after.date) == 10 and rec_mig_after.date[4] == "-"
+
+    # Legacy inline text parity (no plan_path/repo, no log state)
+    legacy_text = (
+        "# IPD: Legacy orch\n\n"
+        "- Id: lg1001\n"
+        "- Coverage: pass\n"
+        f"- Coverage-Fingerprint: {runner_shared.probe_cache_digest(_orchestrator_body('ch1001'))}\n"
+        "- Coverage-Checked: 2026-10-01 by legacy-model\n\n"
+        + _orchestrator_body("ch1001")
+    )
+    rec_leg = coverage_record.read(legacy_text)
+    assert rec_leg.verdict == coverage_record.COVERAGE_PASS
+    assert rec_leg.date == "2026-10-01"
+    assert rec_leg.model == "legacy-model"
+
