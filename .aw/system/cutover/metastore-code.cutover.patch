+def test_review_staleness_log_only_scope_paths_and_cache_invalidation(
+    tmp_path: Path,
+) -> None:
+    """review_staleness_index finds log-only plan-review commits, flags log-only Scope-Paths mutations, and invalidates cache on log mtime."""
+    plan_readiness.clear_review_staleness_cache()
+    repo = _init_log_repo(tmp_path, with_git=True)
+    plan_path = _create_log_plan(
+        repo,
+        "st1001",
+        status="to-review",
+        scope_paths=["agent_workflows/a.py"],
+    )
+    _git(repo, "add", ".aw")
+    _git(repo, "commit", "-m", "add plan st1001")
+
+    # Simulate a log-only plan-review commit (modifies ONLY meta/st1001.jsonl, leaving .ipd.md untouched)
+    log_path = repo / ".aw" / "records" / "meta" / "st1001.jsonl"
+    existing_lines = log_path.read_text(encoding="utf-8").splitlines()
+    existing_lines.append(
+        json.dumps(
+            {
+                "v": 1,
+                "seq": 1,
+                "append": 1,
+                "op": "review",
+                "at": "2026-11-26T11:00:00Z",
+                "actor": {"tool": "plan-review"},
+                "round": 1,
+                "review_kind": "gate",
+                "verdict": "APPROVE",
+                "readiness": "go-pending-approval",
+            }
+        )
+    )
+    existing_lines.append(
+        json.dumps(
+            {
+                "v": 1,
+                "seq": 2,
+                "append": 1,
+                "op": "transition",
+                "at": "2026-11-26T11:00:00Z",
+                "actor": {"tool": "plan-review"},
+                "from": "to-review",
+                "to": "reviewed",
+            }
+        )
+    )
+    log_path.write_text("\n".join(existing_lines) + "\n", encoding="utf-8")
+    _git(repo, "add", ".aw/records/meta/st1001.jsonl")
+    _git(repo, "commit", "-m", "plan-review: st1001 APPROVE")
+    rev_sha = _git(repo, "rev-parse", "HEAD")
+
+    rel_plan = plan_path.relative_to(repo).as_posix()
+
+    # Clean right after review (primes _STALENESS_CACHE)
+    idx_clean = plan_readiness.review_staleness_index(repo, [plan_path])
+    assert rel_plan not in idx_clean
+
+    # Now mutate ONLY Scope-Paths in meta/st1001.jsonl WITHOUT touching .ipd.md and WITHOUT clearing cache
+    existing_lines.append(
+        json.dumps(
+            {
+                "v": 1,
+                "seq": 3,
+                "append": 3,
+                "op": "set",
+                "at": "2026-11-26T12:00:00Z",
+                "actor": {"tool": "aw set"},
+                "fields": {
+                    "scope_paths": ["agent_workflows/a.py", "agent_workflows/b.py"]
+                },
+            }
+        )
+    )
+    log_path.write_text("\n".join(existing_lines) + "\n", encoding="utf-8")
+    # Bump log mtime to guarantee distinct mtime_ns even on coarse filesystems
+    st_now = log_path.stat()
+    os.utime(log_path, ns=(st_now.st_atime_ns, st_now.st_mtime_ns + 1_000_000))
+
+    idx_stale = plan_readiness.review_staleness_index(repo, [plan_path])
+    assert rel_plan in idx_stale
+    assert idx_stale[rel_plan].reviewed_commit == rev_sha
+    assert "substantive-edit" in idx_stale[rel_plan].reasons
+
+    # Pure review_staleness_from_texts check (3-arg unchanged, keyword args catch scope delta on identical text)
+    same_text = plan_path.read_text(encoding="utf-8")
+    assert plan_readiness.review_staleness_from_texts(same_text, same_text, rev_sha) is None
+    st_delta = plan_readiness.review_staleness_from_texts(
+        same_text,
+        same_text,
+        rev_sha,
+        reviewed_scope_paths=["agent_workflows/a.py"],
+        current_scope_paths=["agent_workflows/a.py", "agent_workflows/b.py"],
+    )
+    assert st_delta is not None
+    assert st_delta.reasons == ("substantive-edit",)
+    assert (
+        plan_readiness.review_staleness_from_texts(
+            same_text,
+            same_text,
+            rev_sha,
+            reviewed_scope_paths=["grandfathered"],
+            current_scope_paths=["agent_workflows/a.py"],
+        )
+        is None
+    )
+
