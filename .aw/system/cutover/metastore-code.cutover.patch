+
+    dangling = check_engine.check_review_dangling(repo)
+    dangling_paths = {Path(d.location).name for d in dangling}
+    assert dangling_paths == {dangling_ipd.name, dangling_spec.name}
+    assert all(d.rule == "check.review-dangling" for d in dangling)
+
+    # Finding escalation flags unescalated HIGH finding without false REV-M101 malformed drift
