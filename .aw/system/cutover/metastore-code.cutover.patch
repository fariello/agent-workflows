+def _init_log_repo(tmp_path: Path, *, name: str = "repo", git: bool = True) -> Path:
+    repo = tmp_path / name
+    for sub in (
+        ".aw/config",
+        ".aw/state",
+        ".aw/records/meta",
+        ".aw/records/research",
+    ):
+        (repo / sub).mkdir(parents=True, exist_ok=True)
+    (repo / ".aw" / "config" / "project.json").write_text(
+        json.dumps(
+            {
+                "metadata_schema": 2,
+                "records_backend": "repository",
+                "placements": {"records": "target-tracked"},
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    if git:
+        subprocess.run(["git", "init", "-q"], cwd=repo, check=True)
+        subprocess.run(
+            ["git", "config", "user.email", "test@example.com"], cwd=repo, check=True
+        )
+        subprocess.run(
+            ["git", "config", "user.name", "Test User"], cwd=repo, check=True
+        )
+        subprocess.run(["git", "add", "-A"], cwd=repo, check=True)
+        subprocess.run(["git", "commit", "-q", "-m", "init"], cwd=repo, check=True)
+    return repo
+
+
+def _git_commit_all(repo: Path, msg: str = "seed") -> None:
+    subprocess.run(["git", "add", "-A"], cwd=repo, check=True)
+    subprocess.run(["git", "commit", "-q", "-m", msg], cwd=repo, check=True)
+
+
+def _git_last_commit_files(repo: Path) -> List[str]:
+    proc = subprocess.run(
+        ["git", "log", "-1", "--name-only", "--pretty=format:"],
+        cwd=repo,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]
+
+
+def _run_cli(repo: Path, argv: List[str]) -> Tuple[int, str, str]:
+    out, err = io.StringIO(), io.StringIO()
+    if len(argv) >= 2 and argv[0] == "research" and argv[1] in ("new", "new-comparison"):
+        full_argv = [argv[0], argv[1], str(repo), *argv[2:]]
+    else:
+        full_argv = [*argv, "--dir", str(repo)]
+    with redirect_stdout(out), redirect_stderr(err):
+        try:
+            rc = cli.main(full_argv)
+        except SystemExit as exc:
+            rc = int(exc.code or 0)
+    return rc, out.getvalue(), err.getvalue()
+
+
+def _find_research_doc(repo: Path, id6: str) -> Path:
+    rroot = repo / ".aw" / "records" / "research"
+    matches = [
+        p
+        for p in rroot.rglob(f"*{id6}*.md")
+        if p.is_file() and R.companion_owner_stem(p, rroot) is None
+    ]
+    assert len(matches) == 1, f"expected 1 research doc for {id6}, got {matches}"
+    return matches[0]
+
