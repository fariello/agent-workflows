+    assert bkl_repo_rel not in p_inflight.read_text(encoding="utf-8")
+    _git_commit_all(repo, "seed backlog and citing plans")
+
+    # 1. Direct classify_citing_plans_for_rewrite & filter_in_flight_plan_edits tests on log-format plans
+    rewritable_no_rcpt, skips_no_rcpt = refs.classify_citing_plans_for_rewrite(
