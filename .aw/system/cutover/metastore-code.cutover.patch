+        ),
+        encoding="utf-8",
+    )
+    (reviews_dir / "20261126-sp2001-01-sp2001-spec.review.md").write_text(
+        _render_mirror_review("sp2001", "spec"), encoding="utf-8"
+    )
+    # Dangling ipd and spec mirrors
+    dangling_ipd = reviews_dir / "20261126-demo-02-zz1111-missing-plan.review.md"
+    dangling_ipd.write_text(_render_mirror_review("zz1111", "ipd"), encoding="utf-8")
+    dangling_spec = reviews_dir / "20261126-zz2222-01-zz2222-missing-spec.review.md"
+    dangling_spec.write_text(_render_mirror_review("zz2222", "spec"), encoding="utf-8")
+    # Invalid subject_type must NOT default to ipd
+    invalid_type_rev = reviews_dir / "20261126-demo-03-zz3333-bad-type.review.md"
+    invalid_type_rev.write_text(
+        _render_mirror_review("zz3333", "bogus"), encoding="utf-8"
