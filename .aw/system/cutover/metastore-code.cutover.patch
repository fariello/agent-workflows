+    assert rc_grad == 0, f"backlog graduate failed: {out_grad}\n{err_grad}"
+    grad_data = json.loads(out_grad)
+    expected_new_rel = ".aw/records/backlog/graduated/20261126-bk4001-demo-item.backlog.md"
