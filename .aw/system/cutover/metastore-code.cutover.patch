+
+    cases = [
+        ("plans", "approved", "pln101", "alph01", p_plan),
+        ("specs", "to-review", "spc101", "spc101", p_spec),
+        ("backlog", "open", "bkl101", "bklset", p_backlog),
+        ("research", "reference", "res101", "resset", p_research),
+        ("releases", "planned", "rel101", "relset", p_release),
+        ("prompts", "pending", "prm101", "prmset", p_prompt),
