diff --git a/tests/test_ipd_log_format.py b/tests/test_ipd_log_format.py
new file mode 100644
index 000000000..7070588a2
--- /dev/null
+++ b/tests/test_ipd_log_format.py
@@ -0,0 +1,1088 @@
+"""Standalone core behavioral tests for log-aware IPD schema, lint, scaffold, and sync.
+
+IPD hdwqex (backlog jycxw8, spec 4sd62s Section 4.1, patched ipd-structure-and-linting spec
+Sections 4.3-4.4). Uses stdlib, pytest, and ``agent_workflows.*`` only (no ``tests.record_builder``
+or ``tests.support`` imports) so it runs cleanly on the cutover scratch tree ahead of ``89mtbl``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+import pytest
+
+from agent_workflows import artifact_meta as _meta
+from agent_workflows import check_engine as _ce
+from agent_workflows import ipd_authoring as _auth
+from agent_workflows import ipd_lint as _lint
+from agent_workflows import ipd_schema as _schema
+
+
+pytestmark = pytest.mark.core
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+TEMPLATES_DIR = REPO_ROOT / ".aw" / "system" / "workflows" / "assess" / "templates"
+
+
+def _init_temp_repo(tmp_path: Path) -> Path:
+    """Create a minimal in-repo ``.aw/records/`` layout for behavioral tests."""
+    (tmp_path / ".aw" / "records" / "plans" / "pending").mkdir(parents=True)
+    (tmp_path / ".aw" / "records" / "plans" / "executed").mkdir(parents=True)
+    (tmp_path / ".aw" / "records" / "meta").mkdir(parents=True)
+    (tmp_path / ".aw" / "state").mkdir(parents=True)
+    return tmp_path
+
+
+def _clean_child_body(
+    *,
+    title: str = "Sample log plan",
+    extra_before_goal: str = "",
+    e_checked: bool = False,
+    e_state: str = "pending",
+    v_checked: bool = False,
+    v_result: str = "pending",
+    v_obs: str = "",
+    goal_text: str = "Implement the target behavior cleanly.",
+) -> str:
+    e_box = "x" if e_checked else " "
+    v_box = "x" if v_checked else " "
+    obs_line = f"  - Observed evidence: {v_obs}" if v_obs else "  - Observed evidence:"
+    return (
+        f"# IPD: {title}\n\n"
+        "> Write and proofread this plan per the technical writing standard.\n\n"
+        f"{extra_before_goal}"
+        "## Goal\n\n"
+        f"{goal_text}\n\n"
+        "## Detailed Implementation Checklist (TODO)\n\n"
+        "### Task group 1: core\n\n"
+        f"- [{e_box}] E-01 Update target behavior in `agent_workflows/example.py`.\n"
+        "  - Depends on: none\n"
+        "  - Expected outcome: target behavior passes checks.\n"
+        f"  - Execution state: {e_state}\n\n"
+        "## Project conventions discovered (Step 0)\n\n"
+        "- Follow stdlib-only conventions.\n\n"
+        "## Findings\n\n"
+        "None.\n\n"
+        "## Proposed changes (ordered, validatable)\n\n"
+        "1. E-01 updates target behavior.\n\n"
+        "## Deferred / out of scope (with reason)\n\n"
+        "None.\n\n"
+        "## Scope check\n\n"
+        "- Over-scope: none.\n"
+        "- Under-scope: none.\n\n"
+        "## Required tests / validation\n\n"
+        "Run unit checks for `agent_workflows/example.py`.\n\n"
+        "## Spec / documentation sync\n\n"
+        "N/A, internal implementation only.\n\n"
+        "## Open questions\n\n"
+        "None open.\n\n"
+        "## Validation and cross-check (verify before reporting done)\n\n"
+        f"- [{v_box}] V-01 validates E-01\n"
+        "  - Required evidence: paste test output for `agent_workflows/example.py`.\n"
+        f"{obs_line}\n"
+        f"  - Result: {v_result}\n\n"
+        "## Approval and execution gate\n\n"
+        "- Size assessment: standard\n"
+        "- Cohesion rationale: not required\n\n"
+        "Execute after approval and finalize via `aw ipd finalize`.\n"
+    )
+
+
+def _clean_orchestrator_body(
+    *,
+    title: str = "Sample orchestrator",
+    child_id6: str = "ch1ld1",
+    extra_before_goal: str = "",
+) -> str:
+    return (
+        f"# IPD: {title}\n\n"
+        "> Write and proofread this plan per the technical writing standard.\n\n"
+        f"{extra_before_goal}"
+        "## Goal\n\n"
+        "Coordinate the sample Set.\n\n"
+        "## Detailed Implementation Checklist (TODO)\n\n"
+        "### Task group 1: children\n\n"
+        f"- [ ] E-01 CONFIRM {child_id6} REACHED executed\n"
+        "  - Depends on: none\n"
+        "  - Expected outcome: child reaches executed.\n"
+        "  - Execution state: pending\n\n"
+        "## Child IPDs, sequence, and dependencies\n\n"
+        "| Order | Id | File | What it does | Depends on |\n"
+        "|---|---|---|---|---|\n"
+        f"| 01 | `{child_id6}` | `20261125-demo-01-{child_id6}-child.ipd.md` | Does the work. | none |\n\n"
+        "## Completion criteria (the whole Set is done only when)\n\n"
+        f"- Work is validated. Owner: {child_id6}\n\n"
+        "## Cross-IPD validation\n\n"
+        f"- Child `{child_id6}` runs the full check.\n\n"
+        "## Deferred / out of scope (with reason)\n\n"
+        "None.\n\n"
+        "## Scope check\n\n"
+        "- Over-scope: none.\n"
+        "- Under-scope: none.\n\n"
+        "## Required tests / validation\n\n"
+        f"Child `{child_id6}` runs the checks.\n\n"
+        "## Open questions\n\n"
+        "None open.\n\n"
+        "## Validation and cross-check (verify before reporting the Set complete)\n\n"
+        "- [ ] V-01 validates E-01\n"
+        f"  - Required evidence: paste `aw find plans {child_id6}` output.\n"
+        "  - Observed evidence:\n"
+        "  - Result: pending\n\n"
+        "## Approval and execution gate\n\n"
+        "- Size assessment: standard\n"
+        "- Cohesion rationale: not required\n\n"
+        "Finalize via `aw ipd finalize`.\n"
+    )
+
+
+def _legacy_bullet_child(
+    *,
+    omit_fields: Optional[List[str]] = None,
+    extra_bullets: Optional[List[str]] = None,
+) -> str:
+    omit = set(omit_fields or [])
+    bullets = [
+        ("Date", "2026-11-25"),
+        ("Kind", "child"),
+        ("Concern", "Legacy bullet parity check."),
+        ("Scope", "Keep legacy bullet parsing intact."),
+        ("Scope-Paths", "agent_workflows/example.py"),
+        ("Item-Dependencies", "none"),
+        ("Status", "draft"),
+        ("Work-Kind", "bug"),
+        ("Priority", "high"),
+        ("Set", "demo"),
+        ("Order", "1"),
+        ("Highest E allocated", "01"),
+        ("Author", "tester/model"),
+        ("Id", "leg001"),
+    ]
+    bullet_lines = [f"- {k}: {v}" for k, v in bullets if k not in omit]
+    if extra_bullets:
+        bullet_lines.extend(extra_bullets)
+    return (
+        "# IPD: Legacy bullet plan\n\n"
+        + "\n".join(bullet_lines)
+        + "\n\n"
+        "## Workflow history\n\n"
+        "- 2026-11-25 draft (tester/model): created.\n\n"
+        "## Goal\n\n"
+        "Keep legacy bullet format working.\n\n"
+        "## Detailed Implementation Checklist (TODO)\n\n"
+        "### Task group 1: core\n\n"
+        "- [ ] E-01 Verify legacy bullet parsing.\n"
+        "  - Depends on: none\n"
+        "  - Expected outcome: legacy plan lints cleanly.\n"
+        "  - Execution state: pending\n\n"
+        "## Project conventions discovered (Step 0)\n\n"
+        "- Legacy format.\n\n"
+        "## Findings\n\n"
+        "None.\n\n"
+        "## Proposed changes (ordered, validatable)\n\n"
+        "1. E-01.\n\n"
+        "## Deferred / out of scope (with reason)\n\n"
+        "None.\n\n"
+        "## Scope check\n\n"
+        "- Over-scope: none.\n"
+        "- Under-scope: none.\n\n"
+        "## Required tests / validation\n\n"
+        "Run lint check.\n\n"
+        "## Spec / documentation sync\n\n"
+        "N/A.\n\n"
+        "## Open questions\n\n"
+        "None open.\n\n"
+        "## Validation and cross-check (verify before reporting done)\n\n"
+        "- [ ] V-01 validates E-01\n"
+        "  - Required evidence: paste lint output.\n"
+        "  - Observed evidence:\n"
+        "  - Result: pending\n\n"
+        "## Approval and execution gate\n\n"
+        "- Size assessment: standard\n"
+        "- Cohesion rationale: not required\n\n"
+        "Finalize via `aw ipd finalize`.\n"
+    )
+
+
+def _create_log_plan(
+    repo: Path,
+    *,
+    id6: str,
+    rel_dest: str,
+    fields: Dict[str, Any],
+    body: str,
+) -> Path:
+    ctx = _meta.legacy_context(repo)
+    _meta.create(
+        id6,
+        "ipd",
+        fields,
+        body,
+        destination=rel_dest,
+        project_context=ctx,
+        actor={"tool": "test"},
+        message="created.",
+    )
+    return repo / ".aw" / "records" / rel_dest
