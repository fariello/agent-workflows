+def test_review_mirror_parsing_and_subject_id_with_legacy_parity() -> None:
+    valid_text = _render_mirror_review("ab12cd", "ipd", review_ref="20261126-demo-01")
+    parsed = meta.parse_review_mirror(valid_text)
+    assert parsed == {
+        "subject": "ab12cd",
+        "subject_type": "ipd",
+        "ref": "20261126-demo-01",
+    }
+    assert meta.read_review_subject_id(valid_text) == "ab12cd"
+
+    # BOM-prefixed mirror parses cleanly
+    bom_text = "\ufeff" + valid_text
+    assert meta.parse_review_mirror(bom_text) == parsed
+    assert meta.read_review_subject_id(bom_text) == "ab12cd"
+
+    # Unknown YAML key fails closed
+    bad_key_text = (
+        "---\n"
+        "subject: ab12cd\n"
+        "subject_type: ipd\n"
+        "unexpected_key: oops\n"
+        "---\n"
+        "## Round 1\n"
+    )
+    with pytest.raises(ValueError, match="unknown review front matter key"):
+        meta.parse_review_mirror(bad_key_text)
+
+    # parse_review_text on valid spec-4.1a mirror produces zero REV-M101 diagnostics
+    doc = rf.parse_review_text(valid_text)
+    assert doc.diagnostics == ()
+    assert doc.subject_id == "ab12cd"
+    assert doc.subject_type == "ipd"
+    assert len(doc.rounds) == 1
+
+    # Invalid subject_type emits REV-M102 (D_UNKNOWN_SUBJECT_TYPE), not REV-M101
+    bad_type_text = _render_mirror_review("ab12cd", "bogus")
+    bad_type_doc = rf.parse_review_text(bad_type_text)
+    assert [d.code for d in bad_type_doc.diagnostics] == [rf.D_UNKNOWN_SUBJECT_TYPE]
+
+    # Missing rounds emits REV-R001 (D_NO_ROUNDS)
+    no_rounds_text = _render_mirror_review("ab12cd", "ipd", include_rounds=False)
+    no_rounds_doc = rf.parse_review_text(no_rounds_text)
+    assert [d.code for d in no_rounds_doc.diagnostics] == [rf.D_NO_ROUNDS]
+
+    # Malformed YAML header fails closed with REV-M101 (even if legacy-named keys are present)
+    bad_key_doc = rf.parse_review_text(bad_key_text)
+    assert rf.D_MISSING_META in {d.code for d in bad_key_doc.diagnostics}
+    malformed_five_key_yaml = (
+        "---\n"
+        "subject_id: ab12cd\n"
+        "subject_type: ipd\n"
+        "reviewed_at: 2026-11-26\n"
+        "reviewer: test-agent\n"
+        "verdict: APPROVE\n"
+        "---\n"
+        "## Round 1\n"
+    )
+    assert meta.read_review_subject_id(malformed_five_key_yaml) is None
+    malformed_five_doc = rf.parse_review_text(malformed_five_key_yaml)
+    assert rf.D_MISSING_META in {d.code for d in malformed_five_doc.diagnostics}
+
+    # Legacy 5-bullet review preserves existing validation and subject-id reading
+    legacy_text = rf.render_review(
+        subject_id="ef34gh",
+        subject_type="spec",
+        reviewed_at="2026-11-26",
+        reviewer="test-agent",
+        verdict="APPROVE",
+        rounds=[rf.Round(1, (), ())],
+    )
+    assert meta.read_review_subject_id(legacy_text) == "ef34gh"
+    assert rf.parse_review_text(legacy_text).diagnostics == ()
+
+    incomplete_legacy = (
+        "# Review\n\n- Subject-Id: ef34gh\n- Subject-Type: spec\n\n## Round 1\n"
+    )
+    incomplete_doc = rf.parse_review_text(incomplete_legacy)
+    assert rf.D_MISSING_META in {d.code for d in incomplete_doc.diagnostics}
