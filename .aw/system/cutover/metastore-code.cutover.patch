+    p_orch = _create_log_plan(
+        repo,
+        "or3001",
+        status="approved",
+        order=0,
+        plan_role="orchestrator",
+        body=_orchestrator_body("at1001"),
+    )
+
+    # Headless hold
+    q_headless: dict[str, Any] = {"id6": "at1001", "action": "execute", "status": "queued"}
+    held = runner_shared.hold_attended_plan(q_headless, p_att, interactive=False)
+    assert held is True
+    assert q_headless["status"] == "not-run"
+    assert q_headless[runner_shared.NEEDS_INPUT_KEY] is True
+    assert q_headless["refusal"]["code"] == runner_shared.ATTENDED_REQUIRED_CODE
+
+    # Interactive mark
+    q_interactive: dict[str, Any] = {"id6": "at1001", "action": "execute", "status": "queued"}
+    held_int = runner_shared.hold_attended_plan(q_interactive, p_att, interactive=True)
+    assert held_int is False
+    assert q_interactive[runner_shared.ATTENDED_KEY] is True
+    assert q_interactive["status"] == "queued"
+
+    # Non-attended log plan is untouched
+    q_normal: dict[str, Any] = {"id6": "or3001", "action": "execute", "status": "queued"}
