+def _resolve_release_roots(
+    path: Path, *, repo_root: Optional[Path] = None
+) -> Tuple[Optional[Path], Optional[Path]]:
+    """Return ``(records_root, owner_repo_root)`` for a release record path.
+
+    Infers ``records_root`` from ``path.parent.parent`` when ``path.parent.name == "releases"``
+    (or walking up to a ``releases`` ancestor), falling back to ``project_records_dir(repo_root)``
+    or ``project_context.record_owner_root(path)``.
+    """
+    from agent_workflows import project_context as _proj_ctx
+
+    p = Path(path)
+    if not p.is_absolute() and repo_root is not None:
+        p = Path(repo_root) / p
+
+    records_root: Optional[Path] = None
+    if p.parent.name == "releases":
+        records_root = p.parent.parent
+    else:
+        for parent in p.parents:
+            if parent.name == "releases":
+                records_root = parent.parent
+                break
+    if records_root is None and repo_root is not None:
+        records_root = project_records_dir(Path(repo_root).resolve())
+
+    owner: Optional[Path] = Path(repo_root).resolve() if repo_root is not None else None
+    if owner is None:
+        try:
+            owner = _proj_ctx.record_owner_root(p.resolve())
+        except OSError:
+            owner = _proj_ctx.record_owner_root(p)
+    if owner is None and records_root is not None:
+        try:
+            rr = records_root.resolve()
+        except OSError:
+            rr = records_root
+        if rr.name == "records" and rr.parent.name == ".aw":
+            owner = rr.parent.parent
+        elif rr.name == ".agents":
+            owner = rr.parent
+        else:
+            owner = rr
+    if records_root is None and owner is not None:
+        records_root = project_records_dir(owner)
+
+    return records_root, owner
+
+
+def _records_context(records_root: Path, owner: Optional[Path]) -> Any:
+    """Build a LegacyContext pointing ``records`` at ``records_root``."""
+    from agent_workflows import artifact_meta as _meta
+
+    rr = records_root.resolve()
+    repo = owner.resolve() if owner is not None else rr
+    base_ctx = _meta.legacy_context(repo)
+    return type(
+        "LegacyContext",
+        (),
+        {
+            "logical_roots": {
+                "records": str(rr),
+                "state": base_ctx.logical_roots["state"],
+            },
+            "repo_root": repo,
+        },
+    )()
+
+
+def _release_fields_from_state(state: Any) -> _ReleaseFields:
+    """Build ``_ReleaseFields`` from an ``artifact_meta.State``."""
+    fields = getattr(state, "fields", None) or {}
+    id6_raw = _single_token(getattr(state, "id6", None) or fields.get("id"))
+    raw_summary = fields.get("summary")
+    if raw_summary is None or not str(raw_summary).strip():
+        raw_summary = getattr(state, "short_description", None) or fields.get(
+            "short_description"
+        )
+    summary_str = (
+        str(raw_summary).strip()
+        if raw_summary is not None and str(raw_summary).strip()
+        else None
+    )
+    return _ReleaseFields(
+        id6=id6_raw if id6_raw and _core.ID6_RE.match(id6_raw) else None,
+        status=_single_token(getattr(state, "status", None) or fields.get("status")),
+        version=_single_token(fields.get("version")),
+        summary=summary_str,
+    )
