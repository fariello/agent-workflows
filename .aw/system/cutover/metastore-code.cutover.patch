+def test_ipd_lifecycle_begin_finalize_and_legacy_parity(tmp_path: Path) -> None:
+    repo = _init_repo(tmp_path)
+    src_dir = repo / "src"
+    src_dir.mkdir(parents=True, exist_ok=True)
+    (src_dir / "feature.py").write_text("VALUE = 1\n", encoding="utf-8")
+
+    plan_path = _create_log_child_plan(
+        repo, "pl0001", setid="demo", order=1, scope_paths=["src/feature.py"]
+    )
+    _git_commit_all(repo, "initial log-format plan")
+
+    # 1. begin succeeds and freezes log-stored Scope-Paths
+    beg = ipd_lifecycle.begin(
+        repo,
+        plan_path,
+        "antigravity/gemini",
+        timestamp="2026-11-27T12:00:00Z",
+    )
+    assert beg.exit_code == ipd_lifecycle.EXIT_OK, (beg.message, beg.findings)
+    assert beg.receipt is not None
+    assert beg.receipt["plan_id"] == "pl0001"
+    assert beg.receipt["scope_paths"] == ["src/feature.py"]
+
+    # 2. Execute in-scope change + one out-of-scope change, update E/V evidence, commit work
+    (src_dir / "feature.py").write_text("VALUE = 2\n", encoding="utf-8")
+    (src_dir / "extra.py").write_text("EXTRA = True\n", encoding="utf-8")
+    orig_txt = plan_path.read_text(encoding="utf-8")
+    updated_txt = (
+        orig_txt.replace("- [ ] E-01", "- [x] E-01")
+        .replace("Execution state: pending", "Execution state: performed")
+        .replace("- [ ] V-01", "- [x] V-01")
+        .replace("Observed evidence:", "Observed evidence: pytest passed (1 passed)")
+        .replace("Result: pending", "Result: pass")
+    )
+    plan_path.write_text(updated_txt, encoding="utf-8")
+    _git_commit_all(repo, "implement pl0001")
+
+    # 3. finalize_precheck reconciles frozen log-stored Scope-Paths
+    rc_pre, msg_pre, ev_pre, find_pre = ipd_lifecycle.finalize_precheck(repo, plan_path)
+    assert rc_pre == ipd_lifecycle.EXIT_OK, (msg_pre, find_pre)
+    assert ev_pre["plan_id"] == "pl0001"
+    assert ev_pre["scope_paths"] == ["src/feature.py"]
+    assert "src/extra.py" in ev_pre["scope_audit"]["out_of_scope_paths"]
+
+    # 4. finalize commits BOTH moved plan file and companion meta/pl0001.jsonl with executed status
+    fin = ipd_lifecycle.finalize(
+        repo,
+        plan_path,
+        "antigravity/gemini",
+        "implemented feature",
+        apply=True,
+        scope_reasons={"src/extra.py": "supporting helper needed"},
+    )
+    assert fin.exit_code == ipd_lifecycle.EXIT_OK, (fin.message, fin.findings)
+    assert fin.commit
+    exec_plan = repo / ".aw" / "records" / "plans" / "executed" / plan_path.name
+    assert exec_plan.is_file()
+    assert not plan_path.exists()
+
+    committed = subprocess.check_output(
+        ["git", "show", "--name-only", "--format=", "HEAD"],
+        cwd=repo,
+        text=True,
+    ).splitlines()
+    assert f".aw/records/plans/executed/{plan_path.name}" in committed
+    assert ".aw/records/meta/pl0001.jsonl" in committed
+
+    ctx = meta.legacy_context(repo)
+    st_after = meta.read("pl0001", project_context=ctx)
+    assert st_after.status == "executed"
+
+    # 5. Legacy bullet-format parity: begin still works without companion log
+    leg_src = src_dir / "legacy_mod.py"
+    leg_src.write_text("X = 1\n", encoding="utf-8")
+    leg_plan = (
+        repo
+        / ".aw"
+        / "records"
+        / "plans"
+        / "pending"
+        / "20261126-demo-02-lg0002-legacy.ipd.md"
+    )
+    leg_plan.parent.mkdir(parents=True, exist_ok=True)
+    leg_plan.write_text(
+        "# IPD: Legacy Plan\n\n"
+        "- Date: 2026-11-26\n"
