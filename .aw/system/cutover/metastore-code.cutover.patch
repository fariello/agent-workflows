+def validate_release_state(
+    path: Path, state: Any, *, text: Optional[str] = None
+) -> List[_core.Drift]:
+    """Validate a log-backed release record from ``artifact_meta.State``.
+
+    When ``text`` starts with a YAML mirror (``---``), parses it via
+    ``artifact_meta.parse_artifact_mirror`` and emits ``release.id-missing`` or
+    ``release.status-invalid`` if the mirror is malformed or contradicts ``state``.
+    """
+    from agent_workflows import artifact_meta as _meta
+
+    loc = str(path)
+    drift: List[_core.Drift] = []
+    rf = _release_fields_from_state(state)
+
+    if text is not None:
+        stripped = text.lstrip("\ufeff")
+        if stripped.startswith("---"):
+            try:
+                mirror = _meta.parse_artifact_mirror(stripped)
+            except ValueError as exc:
+                drift.append(
+                    _core.Drift(
+                        loc,
+                        "release.id-missing",
+                        f"malformed YAML mirror: {exc}",
+                    )
+                )
+            else:
+                mirror_id = mirror.get("id")
+                if rf.id6 and mirror_id != rf.id6:
+                    drift.append(
+                        _core.Drift(
+                            loc,
+                            "release.id-missing",
+                            f"YAML mirror id {mirror_id!r} != metadata log id {rf.id6!r}",
+                        )
+                    )
+                mirror_status = mirror.get("status")
+                if rf.status and mirror_status != rf.status:
+                    drift.append(
+                        _core.Drift(
+                            loc,
+                            "release.status-invalid",
+                            f"YAML mirror status {mirror_status!r} != metadata log status {rf.status!r}",
+                        )
+                    )
+
+    drift.extend(_validate_release_fields(loc, rf, text))
+    return drift
+
+
+def validate_release(
+    path: Path,
+    text: str,
+    *,
+    state: Any = None,
+    repo_root: Optional[Path] = None,
+) -> List[_core.Drift]:
+    """Validate a release record's metadata (log-backed or legacy front-matter). Returns Drift
+    for a bad status, missing Version, invalid/missing id6, or corrupt companion log."""
+    loc = str(path)
+    if state is not None:
+        return validate_release_state(path, state, text=text)
+
+    resolved_state, _events, log_error = _read_release_state(
+        path, text, repo_root=repo_root
